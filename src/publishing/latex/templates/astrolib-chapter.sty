\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{astrolib-chapter}[2026/09/07 v1.0 AstroLib Academic Textbook Chapter Style]

\RequirePackage{geometry}
\geometry{
  a4paper,
  top=2.6cm,
  bottom=2.6cm,
  inner=2.5cm,
  outer=3.2cm,
  bindingoffset=0.6cm,
  headheight=14pt,
  headsep=1.2em,
  footskip=2.0em
}

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{amsthm}

\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{graphicx}
\RequirePackage[export]{adjustbox}
\RequirePackage{float}

\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable,theorems}

\RequirePackage{enumitem}
\setlistdepth{8}
\renewlist{itemize}{itemize}{8}
\setlist[itemize]{label=\textbullet, nosep, leftmargin=*, topsep=2pt, partopsep=0pt}
\renewlist{enumerate}{enumerate}{8}
\setlist[enumerate]{nosep, leftmargin=*, topsep=2pt, partopsep=0pt}
\setlist[enumerate,1]{label=\arabic*., nosep, leftmargin=*}
\setlist[enumerate,2]{label=(\arabic*), nosep, leftmargin=*}
\setlist[enumerate,3]{label=(\alph*), nosep, leftmargin=*}

\NewDocumentCommand\astrolibsidenote{ O{注} +m }{
  \begin{remark}[#1]
    #2
  \end{remark}
}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\small\kaishu\leftmark}
\newcommand{\astrolibbooktitle}{}
\fancyhead[R]{\small\kaishu\astrolibbooktitle}
\fancyfoot[C]{\small\normalfont 第 \thepage\ 页}

\IfFontExistsTF{SourceHanSerifSC-Bold.otf}{
  \setCJKfamilyfont{zhbiaosong}{SourceHanSerifSC-Bold.otf}
}{
  \IfFontExistsTF{Source Han Serif SC Bold}{
    \setCJKfamilyfont{zhbiaosong}{Source Han Serif SC Bold}
  }{
    \IfFontExistsTF{Noto Serif CJK SC Bold}{
      \setCJKfamilyfont{zhbiaosong}{Noto Serif CJK SC Bold}
    }{
      \IfFontExistsTF{FandolSong-Bold.otf}{
        \setCJKfamilyfont{zhbiaosong}{FandolSong-Bold.otf}
      }{
        \IfFontExistsTF{STZhongsong}{
          \setCJKfamilyfont{zhbiaosong}{STZhongsong}
        }{
          \setCJKfamilyfont{zhbiaosong}{SimSun}[AutoFakeBold=true]
        }
      }
    }
  }
}
\providecommand{\biaosong}{\CJKfamily{zhbiaosong}}

\ctexset{
  section = {
    format = \Large\bfseries\biaosong,
    aftername = \quad,
  },
  subsection = {
    format = \large\bfseries\biaosong,
    aftername = \quad,
  },
  subsubsection = {
    format = \normalsize\bfseries\biaosong,
    aftername = \quad,
  },
  paragraph = {
    format = \normalsize\bfseries\biaosong,
    aftername = \quad,
  }
}
\@ifclassloaded{ctexbook}{
  \ctexset{
    chapter = {
      format = \huge\bfseries\biaosong\centering,
      aftername = \quad,
    }
  }
}{}

\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=black,
  citecolor=black,
  urlcolor=black!80,
  bookmarksnumbered=true,
  pdfstartview=FitH
}
\RequirePackage{cleveref}

