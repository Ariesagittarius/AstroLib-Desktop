\providecommand{\astrolibchapternum}{1.}

\tcbset{
  astrolib-box/.style={
    enhanced,
    breakable,
    arc=1.5mm,
    boxrule=0.38pt,
    colback=white,
    colframe=black!32,
    fonttitle=\biaosong\bfseries,
    coltitle=black,
    attach title to upper={\;\ },
    separator sign={},
    top=0.85em,
    bottom=0.85em,
    left=1.2em,
    right=1.2em,
    before skip=1.3em plus 0.3em minus 0.2em,
    after skip=1.3em plus 0.3em minus 0.2em,
  }
}

\newtcbtheorem{theorem}{定理}{
  astrolib-box,
  colframe=black!45,
  colback=white,
  separator sign={\ },
  description font=\biaosong,
}{thm}
\makeatletter
\renewcommand{\thetcb@cnt@theorem}{\astrolibchapternum\arabic{tcb@cnt@theorem}}
\makeatother

\newtcbtheorem[use counter from=theorem]{definition}{定义}{
  astrolib-box,
  colframe=black!35,
  colback=white,
  separator sign={\ },
  description font=\biaosong,
}{def}
\newtcbtheorem[use counter from=theorem]{lemma}{引理}{
  astrolib-box,
  colframe=black!38,
  colback=white,
  separator sign={\ },
  description font=\biaosong,
}{lem}
\newtcbtheorem[use counter from=theorem]{corollary}{推论}{
  astrolib-box,
  colframe=black!38,
  colback=white,
  separator sign={\ },
  description font=\biaosong,
}{cor}
\newtcbtheorem[use counter from=theorem]{proposition}{命题}{
  astrolib-box,
  colframe=black!38,
  colback=white,
  separator sign={\ },
  description font=\biaosong,
}{prop}
\newtcbtheorem[use counter from=theorem]{axiom}{公理}{
  astrolib-box,
  colframe=black!45,
  colback=white,
  separator sign={\ },
  description font=\biaosong,
}{axm}
\newtcbtheorem[use counter from=theorem]{property}{性质}{
  astrolib-box,
  colframe=black!35,
  colback=white,
  separator sign={\ },
  description font=\biaosong,
}{prp}
\newtcbtheorem[use counter from=theorem]{criterion}{准则}{
  astrolib-box,
  colframe=black!42,
  colback=white,
  separator sign={\ },
  description font=\biaosong,
}{crit}
\newtcbtheorem[use counter from=theorem]{academicblock}{法则}{
  astrolib-box,
