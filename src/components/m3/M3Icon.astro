---
/**
 * src/components/m3/M3Icon.astro
 * ============================================================================
 * Google Material Symbols 官方标准矢量图标组件
 * ============================================================================
 * 规范：
 * 1. 图标名全部来自 Google Material Symbols (https://github.com/google/material-design-icons)
 * 2. 默认光学尺寸 20px / 24px，默认轮廓 (Outlined) 权重 400
 * 3. 严格对齐 AGENTS.md 6.5「光学度量与尺寸严格统一，优先选用空心或半空心设计」
 * ============================================================================
 */
interface Props {
  name: string;
  size?: number | string;
  fill?: boolean;
  weight?: number;
  grade?: number;
  opticalSize?: number;
  class?: string;
  style?: string;
  ariaHidden?: boolean | 'true' | 'false';
  ariaLabel?: string;
}

const {
  name,
  size = 20,
  fill = false,
  weight = 400,
  grade = 0,
  opticalSize = 20,
  class: className = '',
  style: userStyle = '',
  ariaHidden = true,
  ariaLabel,
} = Astro.props;

const pixelSize = typeof size === 'number' ? `${size}px` : size;
const fontVariationSettings = `'FILL' ${fill ? 1 : 0}, 'wght' ${weight}, 'GRAD' ${grade}, 'opsz' ${opticalSize}`;
---

<span
  class:list={['material-symbols-outlined', 'm3-icon', className]}
  style={`font-size: ${pixelSize}; font-variation-settings: ${fontVariationSettings}; ${userStyle}`}
  aria-hidden={ariaLabel ? undefined : (ariaHidden ? 'true' : undefined)}
  aria-label={ariaLabel}
>{name}</span>

<style>
  .m3-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    vertical-align: middle;
    user-select: none;
    flex-shrink: 0;
    transition: color 0.15s ease, transform 0.15s cubic-bezier(0.2, 0, 0, 1);
  }
</style>
