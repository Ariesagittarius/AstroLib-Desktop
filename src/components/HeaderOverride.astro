---
import config from 'virtual:starlight/user-config';

import Search from 'virtual:starlight/components/Search';

/**
 * Render the `Search` component if Pagefind is enabled or default search is overridden.
 */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<script is:inline>
	(function () {
		try {
			var themeKey = 'starlight-site-theme';
			var theme = localStorage.getItem(themeKey);
			if (!theme || theme === 'vitepress' || theme === 'starlight') {
				theme = 'material-you';
			}
			document.documentElement.dataset.siteTheme = theme;

			var colorThemeKey = 'starlight-theme';
			var colorTheme = localStorage.getItem(colorThemeKey);
			var resolvedColorTheme =
				colorTheme === 'dark' || colorTheme === 'light'
					? colorTheme
					: window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
			document.documentElement.dataset.theme = resolvedColorTheme;
			document.documentElement.style.colorScheme = resolvedColorTheme;

			var fontKey = 'starlight-font';
			var rawFont = localStorage.getItem(fontKey);
			if (rawFont) {
				var parsed = JSON.parse(rawFont);
				if (parsed && typeof parsed === 'object') {
					if (parsed.latin) document.documentElement.dataset.fontLatin = parsed.latin;
					if (parsed.cjk) document.documentElement.dataset.fontCjk = parsed.cjk;
				}
			}
			var indentVal = localStorage.getItem('astrolib_typography_indent');
			if (indentVal === null) indentVal = localStorage.getItem('starlight-paragraph-indent');
			document.documentElement.dataset.paragraphIndent = indentVal === 'false' ? 'false' : 'true';

			var fsVal = parseInt(localStorage.getItem('astrolib_font_size') || '', 10);
			if (!isNaN(fsVal) && fsVal >= 14 && fsVal <= 22) {
				document.documentElement.style.setProperty('--academic-font-size-body', parseFloat((fsVal * 0.75).toFixed(2)) + 'pt');
			}

			if (localStorage.getItem('astrolib_lite_mode') === 'true') {
				document.documentElement.classList.add('astrolib-lite-mode');
			}
			var colorKey = 'starlight-m3-theme-color';
			var m3Color = localStorage.getItem(colorKey);
			if (m3Color) document.documentElement.dataset.m3ThemeColor = m3Color;

			var cachedCss = localStorage.getItem('astrolib_m3_cached_css');
			if (cachedCss && theme === 'material-you') {
				var styleEl = document.getElementById('m3-dynamic-color-theme') || document.createElement('style');
				styleEl.id = 'm3-dynamic-color-theme';
				styleEl.textContent = cachedCss;
				if (!styleEl.parentNode) document.head.appendChild(styleEl);
			}
		} catch (e) {}
	})();
</script>

<div class="m3-header-inner vp-header-inner">
	<!-- Left: Directory Toggle Button (Clean Reader Window - No redundant Brand/Logo) -->
	<div class="m3-brand-wrapper vp-brand-wrapper">
		<!-- 左侧栏收放切换按钮 (全视口统一：桌面折叠/移动端抽屉) -->
		<button
			type="button"
			class="m3-icon-btn m3-sidebar-toggle-btn vp-sidebar-toggle-btn"
			id="vp-sidebar-toggle-btn"
			aria-label="收放全书章节目录"
			title="收放全书章节目录 (Ctrl+B)"
			data-tooltip="收起目录 (Ctrl+B)"
			aria-expanded="true"
			aria-controls="starlight__sidebar"
		>
			<svg class="vp-icon-dock-left" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="3.5" y="4.5" width="17" height="15" rx="2.5" />
				<line x1="9.5" y1="4.5" x2="9.5" y2="19.5" />
			</svg>
			<svg class="vp-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="18" y1="6" x2="6" y2="18" />
				<line x1="6" y1="6" x2="18" y2="18" />
			</svg>
		</button>
	</div>

	<!-- Search Trigger (Google Drive Centered Pill Style) -->
	<div class="m3-search-wrapper vp-search-wrapper print:hidden">
		{shouldRenderSearch && <Search />}
	</div>

	<!-- Right Control Group: Reading Utilities Only (TOC, Bilingual, Lens) -->
	<div class="print:hidden m3-right-group vp-right-group right-group">
		<!-- 0. 右侧栏 / 本章大纲收放按钮 (全视口统一：桌面折叠/移动端大纲) -->
		<button
			type="button"
			class="m3-icon-btn m3-right-sidebar-toggle-btn vp-right-sidebar-toggle-btn"
			id="vp-right-sidebar-toggle-btn"
			aria-label="收放本节大纲与侧载栏"
			title="收放本节大纲 (Alt+T)"
			data-tooltip="收起大纲 (Alt+T)"
			aria-expanded="true"
			aria-controls="astrolib-sideload-dock"
		>
			<svg class="vp-icon-dock-right" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="3.5" y="4.5" width="17" height="15" rx="2.5" />
				<line x1="14.5" y1="4.5" x2="14.5" y2="19.5" />
			</svg>
		</button>

		<!-- 翻译与双语助读专属入口 (Alt+Y) -->
		<button
			type="button"
			class="m3-icon-btn m3-translate-btn vp-translate-btn"
			id="vp-translate-btn"
			data-translation-trigger
			aria-label="双语助读与学术翻译 (Alt+Y)"
			title="双语助读与学术翻译 (Alt+Y)"
			data-tooltip="双语助读 (Alt+Y)"
		>
			<md-icon class="header-mdicon vp-translate-icon" aria-hidden="true">translate</md-icon>
		</button>

		<!-- 关注点透镜与信息高亮入口 (Alt+I) -->
		<button
			type="button"
			class="m3-icon-btn m3-focus-btn vp-focus-btn"
			id="vp-focus-btn"
			data-focus-trigger
			aria-label="关注点透镜与信息高亮 (Alt+I)"
			title="关注点透镜与信息高亮 (Alt+I)"
			data-tooltip="关注点透镜 (Alt+I)"
		>
			<md-icon class="header-mdicon vp-focus-icon" aria-hidden="true">center_focus_strong</md-icon>
		</button>
	</div>
</div>

<style>
	.vp-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		height: 100%;
		gap: 0.75rem;
	}

	.vp-brand-wrapper {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.vp-sidebar-toggle-btn,
	.vp-right-sidebar-toggle-btn,
	.vp-translate-btn,
	.vp-focus-btn,
	.vp-blank-doc-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.125rem;
		height: 2.125rem;
		padding: 0;
		border-radius: 50%;
		border: none;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		flex-shrink: 0;
		transition: background-color 0.15s ease, color 0.15s ease;
		position: relative;
		text-decoration: none;
	}

	.vp-translate-icon,
	.vp-focus-icon,
	.vp-blank-doc-icon,
	.vp-hub-icon {
		font-size: 1.25rem !important;
		width: 1.25rem;
		height: 1.25rem;
	}

	.vp-sidebar-toggle-btn {
		margin-right: 0.45rem;
	}

	:global([data-theme='dark']) .vp-sidebar-toggle-btn,
	:global([data-theme='dark']) .vp-right-sidebar-toggle-btn,
	:global([data-theme='dark']) .vp-translate-btn,
	:global([data-theme='dark']) .vp-focus-btn,
	:global([data-theme='dark']) .vp-blank-doc-btn {
		color: var(--sl-color-gray-2, #e2e8f0);
	}

	.vp-sidebar-toggle-btn:hover,
	.vp-right-sidebar-toggle-btn:hover,
	.vp-translate-btn:hover,
	.vp-focus-btn:hover,
	.vp-blank-doc-btn:hover {
		background-color: var(--sl-color-gray-6, rgba(125, 125, 125, 0.1));
		color: var(--sl-color-text-accent);
	}

	.vp-sidebar-toggle-btn svg,
	.vp-right-sidebar-toggle-btn svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	.vp-sidebar-toggle-btn .vp-icon-close {
		display: none;
	}

	@media (max-width: 71.999rem) {
		.vp-right-sidebar-toggle-btn {
			display: none !important;
		}
	}

	@media (max-width: 49.999rem) {
		:global(body[data-mobile-menu-expanded]) .vp-sidebar-toggle-btn .vp-icon-dock-left {
			display: none;
		}
		:global(body[data-mobile-menu-expanded]) .vp-sidebar-toggle-btn .vp-icon-close {
			display: block;
		}
	}

	/* ==========================================================================
	   Google Material 3 Plain Tooltip System for Header Action Buttons
	   ========================================================================== */
	.vp-sidebar-toggle-btn[data-tooltip],
	.vp-right-sidebar-toggle-btn[data-tooltip],
	.vp-translate-btn[data-tooltip],
	.vp-blank-doc-btn[data-tooltip] {
		position: relative;
	}

	.vp-sidebar-toggle-btn[data-tooltip]::before,
	.vp-right-sidebar-toggle-btn[data-tooltip]::before,
	.vp-translate-btn[data-tooltip]::before,
	.vp-blank-doc-btn[data-tooltip]::before {
		content: attr(data-tooltip);
		position: absolute;
		top: calc(100% + 8px);
		left: 50%;
		transform: translateX(-50%) translateY(-3px);
		padding: 0.25rem 0.5rem;
		font-size: 0.6875rem;
		font-weight: 500;
		line-height: 1;
		white-space: nowrap;
		border-radius: var(--md-shape-corner-extra-small, 4px);
		background-color: var(--md-sys-color-inverse-surface, #313033);
		color: var(--md-sys-color-inverse-on-surface, #f4eff4);
		box-shadow: var(--md-elevation-level-2, 0 2px 6px rgba(0, 0, 0, 0.25));
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.15s cubic-bezier(0.2, 0, 0, 1), transform 0.15s cubic-bezier(0.2, 0, 0, 1), visibility 0.15s;
		z-index: var(--layer-popover, 300);
	}

	.vp-sidebar-toggle-btn[data-tooltip]::after,
	.vp-right-sidebar-toggle-btn[data-tooltip]::after,
	.vp-translate-btn[data-tooltip]::after,
	.vp-blank-doc-btn[data-tooltip]::after {
		content: '';
		position: absolute;
		top: calc(100% + 3px);
		left: 50%;
		transform: translateX(-50%) translateY(-3px);
		border-width: 0 4px 5px 4px;
		border-style: solid;
		border-color: transparent transparent var(--md-sys-color-inverse-surface, #313033) transparent;
		pointer-events: none;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.15s cubic-bezier(0.2, 0, 0, 1), transform 0.15s cubic-bezier(0.2, 0, 0, 1), visibility 0.15s;
		z-index: var(--layer-popover, 300);
	}

	.vp-sidebar-toggle-btn[data-tooltip]:hover::before,
	.vp-sidebar-toggle-btn[data-tooltip]:hover::after,
	.vp-sidebar-toggle-btn[data-tooltip]:focus-visible::before,
	.vp-sidebar-toggle-btn[data-tooltip]:focus-visible::after,
	.vp-right-sidebar-toggle-btn[data-tooltip]:hover::before,
	.vp-right-sidebar-toggle-btn[data-tooltip]:hover::after,
	.vp-right-sidebar-toggle-btn[data-tooltip]:focus-visible::before,
	.vp-right-sidebar-toggle-btn[data-tooltip]:focus-visible::after,
	.vp-translate-btn[data-tooltip]:hover::before,
	.vp-translate-btn[data-tooltip]:hover::after,
	.vp-translate-btn[data-tooltip]:focus-visible::before,
	.vp-translate-btn[data-tooltip]:focus-visible::after,
	.vp-blank-doc-btn[data-tooltip]:hover::before,
	.vp-blank-doc-btn[data-tooltip]:hover::after,
	.vp-blank-doc-btn[data-tooltip]:focus-visible::before,
	.vp-blank-doc-btn[data-tooltip]:focus-visible::after {
		opacity: 1;
		visibility: visible;
		transform: translateX(-50%) translateY(0);
	}

	/* Left tooltip margin alignment */
	.vp-sidebar-toggle-btn[data-tooltip]::before {
		left: 0;
		transform: translateX(0) translateY(-3px);
	}
	.vp-sidebar-toggle-btn[data-tooltip]::after {
		left: 1rem;
		transform: translateX(-50%) translateY(-3px);
	}
	.vp-sidebar-toggle-btn[data-tooltip]:hover::before,
	.vp-sidebar-toggle-btn[data-tooltip]:focus-visible::before {
		transform: translateX(0) translateY(0);
	}
	.vp-sidebar-toggle-btn[data-tooltip]:hover::after,
	.vp-sidebar-toggle-btn[data-tooltip]:focus-visible::after {
		transform: translateX(-50%) translateY(0);
	}

	/* Right tooltip margin alignment */
	.vp-right-sidebar-toggle-btn[data-tooltip]::before {
		left: auto;
		right: 0;
		transform: translateX(0) translateY(-3px);
	}
	.vp-right-sidebar-toggle-btn[data-tooltip]::after {
		left: auto;
		right: 0.85rem;
		transform: translateX(50%) translateY(-3px);
	}
	.vp-right-sidebar-toggle-btn[data-tooltip]:hover::before,
	.vp-right-sidebar-toggle-btn[data-tooltip]:focus-visible::before {
		transform: translateX(0) translateY(0);
	}
	.vp-right-sidebar-toggle-btn[data-tooltip]:hover::after,
	.vp-right-sidebar-toggle-btn[data-tooltip]:focus-visible::after {
		transform: translateX(50%) translateY(0);
	}

	@media (hover: none) {
		.vp-sidebar-toggle-btn[data-tooltip]::before,
		.vp-sidebar-toggle-btn[data-tooltip]::after,
		.vp-right-sidebar-toggle-btn[data-tooltip]::before,
		.vp-right-sidebar-toggle-btn[data-tooltip]::after {
			display: none !important;
		}
	}

	.vp-brand-link {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		text-decoration: none;
		color: inherit;
	}
	.vp-logo-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.vp-logo-img {
		width: 1.65rem;
		height: auto;
		max-height: 1.5rem;
		object-fit: contain;
		flex-shrink: 0;
		display: block;
		transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1);
	}
	.vp-brand-link:hover .vp-logo-img {
		transform: scale(1.05);
	}
	.vp-site-name {
		font-family: var(--font-brand, 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--sl-color-white, #3c3c43);
		white-space: nowrap;
	}

	.vp-search-wrapper {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		max-width: 32rem;
		margin-inline: 0.5rem;
		min-width: 0;
	}

	@media (max-width: 49.999rem) {
		.vp-search-wrapper {
			max-width: none;
			margin-inline: 0.25rem;
			min-width: 2.125rem;
		}
	}

	@media (max-width: 21.5rem) {
		.vp-site-name {
			display: none;
		}
	}

	.vp-right-group {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-left: auto;
		flex-shrink: 0;
	}

	.vp-header-theme-group {
		display: contents;
	}

	.vp-social-group {
		display: contents;
	}
</style>

<script>
	import { sidebarLayoutController } from './sidebar/sidebar-layout-controller';
	import { sideloadManager } from './sideload/sideload-manager';
	import { initColorEngine, applyThemeColor } from '../themes/material-you/color-engine';
	import { features } from '../config/features.config.mjs';
	import { initHeadlessReaderSettings } from '../scripts/feature-toggles';
	import { applyFontPref } from '../scripts/font-presets';
	import { applyParagraphIndent, applyPunctStyle, applyFontSize } from '../scripts/settings/typography-prefs';
	import { applyLiteMode } from '../scripts/settings/performance-prefs';

	const RUNTIME_IDS = new Set([
		'theme',
		'fonts',
		'crossRef',
		'formulaActions',
		'prewarm',
		'relationGraph',
		'mermaid',
		'epub',
		'aiAsk',
		'editor',
		'inspector',
		'pwa',
	]);

	const readerMeta = Object.entries(features).map(([id, f]: [string, any]) => ({
		id,
		label: f.label,
		build: Boolean(f.enabled),
		runtime: RUNTIME_IDS.has(id),
		devOnly: Boolean(f.devOnly),
	}));

	initHeadlessReaderSettings(readerMeta);

	if (typeof window !== 'undefined' && !(window as any).__readerColorSyncBound) {
		(window as any).__readerColorSyncBound = true;
		initColorEngine();

		window.addEventListener('storage', (e) => {
			if (e.key === 'starlight-m3-theme-color') {
				applyThemeColor(e.newValue || undefined);
			} else if (e.key === 'astrolib_m3_cached_css' && e.newValue) {
				let styleEl = document.getElementById('m3-dynamic-color-theme') as HTMLStyleElement | null;
				if (!styleEl) {
					styleEl = document.createElement('style');
					styleEl.id = 'm3-dynamic-color-theme';
					document.head.appendChild(styleEl);
				}
				styleEl.textContent = e.newValue;
			} else if (e.key === 'starlight-theme') {
				const themeVal = e.newValue;
				const effective =
					themeVal === 'dark' || themeVal === 'light'
						? themeVal
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
				document.documentElement.dataset.theme = effective;
				document.documentElement.style.colorScheme = effective;
			}
		});

		window.addEventListener('message', (e) => {
			if (e.data && e.data.type === 'M3_THEME_COLOR_CHANGED') {
				if (e.data.theme || e.data.resolvedTheme) {
					const effective =
						e.data.resolvedTheme === 'dark' || e.data.resolvedTheme === 'light'
							? e.data.resolvedTheme
							: e.data.theme === 'dark' || e.data.theme === 'light'
								? e.data.theme
								: window.matchMedia('(prefers-color-scheme: dark)').matches
									? 'dark'
									: 'light';
					document.documentElement.dataset.theme = effective;
					document.documentElement.style.colorScheme = effective;
				}
				if (e.data.font) {
					try {
						const parsed = typeof e.data.font === 'string' ? JSON.parse(e.data.font) : e.data.font;
						applyFontPref(parsed);
					} catch {}
				}
				if (e.data.fontSize !== undefined && e.data.fontSize !== null) {
					const parsedSize = parseInt(String(e.data.fontSize), 10);
					if (!isNaN(parsedSize)) applyFontSize(parsedSize);
				}
				if (e.data.punctStyle === 'dot' || e.data.punctStyle === 'circle') {
					applyPunctStyle(e.data.punctStyle);
				}
				if (e.data.indent !== undefined && e.data.indent !== null) {
					applyParagraphIndent(String(e.data.indent) !== 'false');
				}
				if (e.data.liteMode !== undefined && e.data.liteMode !== null) {
					applyLiteMode(String(e.data.liteMode) === 'true');
				}
				if (e.data.features !== undefined) {
					initHeadlessReaderSettings(readerMeta);
				}
				const cssContent = e.data.schemeCss || e.data.css;
				if (cssContent) {
					let styleEl = document.getElementById('m3-dynamic-color-theme') as HTMLStyleElement | null;
					if (!styleEl) {
						styleEl = document.createElement('style');
						styleEl.id = 'm3-dynamic-color-theme';
					}
					styleEl.textContent = cssContent;
					document.head.appendChild(styleEl);
				} else if (e.data.color) {
					applyThemeColor(e.data.color);
				}
			}
		});
	}

	function setupHeaderSidebars() {
		sidebarLayoutController.init();
		sideloadManager.init();

		const leftBtn = document.getElementById('vp-sidebar-toggle-btn');
		const rightBtn = document.getElementById('vp-right-sidebar-toggle-btn');

		if (leftBtn && !leftBtn.dataset.bound) {
			leftBtn.dataset.bound = 'true';
			leftBtn.addEventListener('click', () => {
				sidebarLayoutController.toggleLeftSidebar();
			});
		}

		if (rightBtn && !rightBtn.dataset.bound) {
			rightBtn.dataset.bound = 'true';
			rightBtn.addEventListener('click', () => {
				if (window.matchMedia('(max-width: 71.999rem)').matches) {
					// 移动端/平板端：触发大纲 popup/抽屉
					const localNavBtn = document.querySelector('.vp-local-nav-btn') as HTMLButtonElement | null;
					if (localNavBtn) {
						localNavBtn.click();
					} else {
						sideloadManager.toggleRightSidebar();
					}
				} else {
					// 桌面端：折叠或展开右侧分栏
					sideloadManager.toggleRightSidebar();
				}
			});
		}

		function syncButtons() {
			if (leftBtn) {
				const state = sidebarLayoutController.getState();
				const isCollapsed = state.isMobile ? !state.mobileExpanded : state.collapsed;
				leftBtn.setAttribute('aria-expanded', String(!isCollapsed));
				leftBtn.classList.toggle('is-collapsed', isCollapsed);
				const leftTip = isCollapsed ? '展开目录 (Ctrl+B)' : '收起目录 (Ctrl+B)';
				leftBtn.setAttribute('data-tooltip', leftTip);
				leftBtn.setAttribute('title', leftTip);
			}

			if (rightBtn) {
				const isCollapsed = sideloadManager.isCollapsed();
				rightBtn.setAttribute('aria-expanded', String(!isCollapsed));
				rightBtn.classList.toggle('is-collapsed', isCollapsed);
				const rightTip = isCollapsed ? '展开大纲 (Alt+T)' : '收起大纲 (Alt+T)';
				rightBtn.setAttribute('data-tooltip', rightTip);
				rightBtn.setAttribute('title', rightTip);
			}
		}

		syncButtons();

		sidebarLayoutController.subscribe(syncButtons);
		sideloadManager.subscribe(syncButtons);

		// 监听移动端菜单展开状态
		const observer = new MutationObserver(syncButtons);
		observer.observe(document.body, { attributes: true, attributeFilter: ['data-mobile-menu-expanded'] });
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupHeaderSidebars);
	} else {
		setupHeaderSidebars();
	}
	document.addEventListener('astro:page-load', setupHeaderSidebars);

	// 全局监听 Alt+B 开启空白文档与学术工作台，并支持选中文段携带
	if (typeof window !== 'undefined' && !(window as any).__blankDocBound) {
		(window as any).__blankDocBound = true;
		window.addEventListener('keydown', (e: KeyboardEvent) => {
			const target = e.target as HTMLElement | null;
			if (target && (
				target.tagName === 'INPUT' ||
				target.tagName === 'TEXTAREA' ||
				target.tagName === 'MD-OUTLINED-TEXT-FIELD' ||
				target.isContentEditable
			)) {
				return;
			}
			if (e.altKey && e.key.toLowerCase() === 'b' && !e.ctrlKey && !e.metaKey) {
				e.preventDefault();
				const selection = window.getSelection()?.toString().trim();
				if (selection) {
					sessionStorage.setItem('astrolib_blank_import_snippet', selection);
				}
				sessionStorage.setItem('astrolib_blank_return_url', window.location.href);
				window.open('/blank/', '_blank');
			}
		});

		document.addEventListener('click', (e) => {
			const target = (e.target as HTMLElement | null)?.closest('[data-blank-doc-trigger]');
			if (target) {
				const selection = window.getSelection()?.toString().trim();
				if (selection) {
					sessionStorage.setItem('astrolib_blank_import_snippet', selection);
				}
				sessionStorage.setItem('astrolib_blank_return_url', window.location.href);
			}
		});
	}

	// 全局监听 Alt+I 开启/切换关注点透镜
	if (typeof window !== 'undefined' && !(window as any).__focusShortcutBound) {
		(window as any).__focusShortcutBound = true;
		window.addEventListener('keydown', (e: KeyboardEvent) => {
			const target = e.target as HTMLElement | null;
			if (target && (
				target.tagName === 'INPUT' ||
				target.tagName === 'TEXTAREA' ||
				target.tagName === 'MD-OUTLINED-TEXT-FIELD' ||
				target.isContentEditable
			)) {
				return;
			}
			if (e.altKey && e.key.toLowerCase() === 'i' && !e.ctrlKey && !e.metaKey) {
				e.preventDefault();
				sideloadManager.toggle('focus');
			}
		});

		// 全局点击代理：确保点击顶栏或任何部位的透镜按钮能无缝唤起关注点透镜
		document.addEventListener('click', (e) => {
			const target = (e.target as HTMLElement | null)?.closest('[data-focus-trigger]');
			if (target) {
				e.preventDefault();
				sideloadManager.toggle('focus');
			}
		});
	}
</script>
