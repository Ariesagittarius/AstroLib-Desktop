---
/**
 * src/components/VpNav.astro
 * ============================================================================
 * [已迁移 -> M3TopNavBar.astro]
 * 本文件作为向后兼容代理，将请求直接转发至 M3 统一顶栏组件 M3TopNavBar。
 * 所有页面新代码均推荐直接使用 import M3TopNavBar from '../components/m3/M3TopNavBar.astro'。
 * ============================================================================
 */
import M3TopNavBar from './m3/M3TopNavBar.astro';

interface Props {
  currentPath?: string;
  siteTitle?: string;
  showSearch?: boolean;
  showThemeToggle?: boolean;
  showHubButton?: boolean;
  showGithubLink?: boolean;
  class?: string;
}

const props = Astro.props;
---

<M3TopNavBar {...props}>
  <slot name="brand-extra" slot="brand-extra" />
  <slot name="search" slot="search" />
  <slot name="nav-links" slot="nav-links" />
  <slot name="actions" slot="actions" />
  <slot name="mobile-links" slot="mobile-links" />
  <slot />
</M3TopNavBar>
