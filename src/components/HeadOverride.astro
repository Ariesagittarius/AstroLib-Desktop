---
import { collections } from '../config/collections.config.ts';

const route = Astro.locals.starlightRoute;
const { head = [], entry } = route || {};
const pathname = Astro.url.pathname;
const rawTitle = entry?.data?.title || route?.siteTitle || 'AstroLib';

const cleanTitle = String(rawTitle)
  .replace(/\$([^\$]+)\$/g, '$1')
  .replace(/\\(?:mathbf|boldsymbol|pmb|text|mathbb|mathrm)\{([^}]+)\}/g, '$1')
  .replace(/\\[a-zA-Z]+/g, '')
  .replace(/[\$\{\}\^\\]/g, '')
  .trim();

const entryId = entry?.id || '';
const entrySlug = (entry as any)?.slug || entry?.id || '';

let currentBook = null;
for (const col of collections) {
  for (const book of col.books) {
    const pattern = `${col.slug}/${book.slug}`;
    if (pathname.includes(pattern) || entrySlug.includes(pattern) || entryId.includes(pattern)) {
      currentBook = book;
      break;
    }
  }
  if (currentBook) break;
}

const enhancedTitle = currentBook
  ? `${cleanTitle} · 《${currentBook.title}》 - AstroLib`
  : `${cleanTitle} - AstroLib`;

const finalDescription =
  entry?.data?.description ||
  (currentBook
    ? `《${currentBook.title}》${cleanTitle}`
    : 'AstroLib 理工科教材与学术资料阅读与自测工作站');

const processedHead = head.filter((item) => {
  if (item.tag === 'title') return false;
  if (item.tag === 'meta' && item.attrs?.name === 'description') return false;
  return true;
});
---

{processedHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

<script is:inline>try {
    if (localStorage.getItem('astrolib_lite_mode') === 'true') {
      document.documentElement.dataset.liteMode = 'true';
      document.documentElement.classList.add('astrolib-lite-mode');
    }
  } catch (e) {}
</script>

<title>{enhancedTitle}</title>
<meta name="description" content={finalDescription} />
