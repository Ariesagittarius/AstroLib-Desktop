---
/**
 * src/components/harness/HarnessTopBar.astro
 * ============================================================================
 * Agent Harness 顶部导航与操作栏
 * ============================================================================
 */
---

<header class="harness-top-bar" id="harness-top-bar">
  <div class="harness-top-bar__left">
    <div class="harness-nav-controls">
      <button type="button" class="harness-icon-btn" id="harness-btn-toggle-sidebar" title="切换左侧栏 (Ctrl+B)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="9" y1="3" x2="9" y2="21"></line>
        </svg>
      </button>
      <button type="button" class="harness-icon-btn" id="harness-btn-quick-search" title="搜索实体或命令 (Ctrl+P)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="harness-top-bar__center">
    <div class="harness-breadcrumb">
      <span>AstroLib</span> / <strong id="harness-current-session-title">智能体工作台任务流</strong>
    </div>
  </div>

  <div class="harness-top-bar__right">
    <button type="button" class="harness-icon-btn" id="harness-btn-toggle-split" title="切换工作区侧边书库/分屏 (Alt+\)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="15" y1="3" x2="15" y2="21"></line>
      </svg>
    </button>
  </div>
</header>
