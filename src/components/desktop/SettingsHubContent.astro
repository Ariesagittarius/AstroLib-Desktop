---
/**
 * src/components/desktop/SettingsHubContent.astro
 * ============================================================================
 * AstroLib 控制中心、阅读设置与扩展仓库共享核心视图 (单一生产实现)
 * ============================================================================
 * 职责：
 * 1. 作为窗口内覆盖层模态框（Desktop In-Window Modal）与独立 /hub/ 路由的统一 UI；
 * 2. 严格按 Material Design 3 (M3) 规范提供 <md-switch> 与 Filter Chips；
 * 3. 单一宿主契约：全局仅保留一个 starlight-feature-toggles 宿主，杜绝重复绑定与状态冲突。
 * ============================================================================
 */
import { features } from '../../config/features.config.ts';
import { DEFAULT_DESKTOP_RELEASE_REPO } from '../../config/release.config';
import { CJK_PRESETS, LATIN_PRESETS, DEFAULT_PREF } from '../../scripts/font-presets';
import { THEME_COLOR_PRESETS } from '../../themes/material-you/color-engine';
import SettingsSystemPanels from './SettingsSystemPanels.astro';
import SettingsIngestPanel from './SettingsIngestPanel.astro';
import SettingsAgentPanel from './SettingsAgentPanel.astro';
import '../../styles/components/feature-toggles.css';
import '../../styles/components/settings-hub.css';

interface Props {
  isOverlay?: boolean;
}

const { isOverlay = true } = Astro.props;
const isDev = import.meta.env.DEV;

const RUNTIME_IDS = new Set([
  'theme',
  'fonts',
  'crossRef',
  'formulaActions',
  'mermaid',
  'aiAsk',
  'translation',
  'bilingualComparison',
  'infoHighlight',
  'chapterExport',
  'exercises',
]);

const featureMeta = Object.entries(features).map(([id, f]) => ({
  id,
  label: f.label,
  build: f.enabled,
  runtime: RUNTIME_IDS.has(id),
  devOnly: f.devOnly,
}));
const metaJson = JSON.stringify(featureMeta);
---

<div class:list={['hub-root-shell', isOverlay ? 'hub-root-shell--overlay' : 'hub-root-shell--standalone']} data-hub-root>
  {!isOverlay && (
    <header class="hub-header">
      <div class="hub-header-left">
        <img src="/favicon.png" alt="AstroLib" class="hub-logo" />
        <span class="hub-title">控制中心与扩展仓库</span>
      </div>
      <div class="hub-header-right">
        <div id="env-badge" class="hub-env-pill">
          <span class="pulse-dot"></span>
          <span id="env-text">正在探活运行时...</span>
        </div>
      </div>
    </header>
  )}

  <div class="hub-container">
    <!-- 左侧导航栏 -->
    <nav class="hub-sidebar" aria-label="设置分类导航">
      {isOverlay && (
        <div class="hub-sidebar-top">
          <div class="hub-sidebar-brand">设置与控制中心</div>
          <div id="env-badge" class="hub-env-pill hub-env-pill--compact">
            <span class="pulse-dot"></span>
            <span id="env-text">正在探活运行时...</span>
          </div>
        </div>
      )}

      <div class="hub-nav-list">
        <button type="button" class="hub-nav-item active" data-target="panel-appearance">
          <span class="material-symbols-outlined hub-nav-icon">palette</span>
          <span>外观与排版偏好</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-reading">
          <span class="material-symbols-outlined hub-nav-icon">tune</span>
          <span>阅读设置</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-ingest">
          <span class="material-symbols-outlined hub-nav-icon">description</span>
          <span>文献解析与研读</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-diagnostics">
          <span class="material-symbols-outlined hub-nav-icon">developer_board</span>
          <span>硬件与自省环境</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-models">
          <span class="material-symbols-outlined hub-nav-icon">model_training</span>
          <span>端侧模型仓库</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-agent">
          <span class="material-symbols-outlined hub-nav-icon">smart_toy</span>
          <span>Agent 与工具</span>
        </button>
      </div>
    </nav>

    <!-- 右侧主内容列 -->
    <div class="hub-main-column">
      {isOverlay && (
        <div class="hub-modal-topbar">
          <div class="hub-modal-topbar-meta">
            <span class="hub-modal-section-heading" id="hub-modal-section-heading">外观与排版偏好</span>
          </div>
          <button
            type="button"
            class="hub-overlay-close-btn"
            id="hub-overlay-close-btn"
            title="关闭设置 (Esc)"
            aria-label="关闭设置"
          >
            <span class="material-symbols-outlined" style="font-size: 20px;">close</span>
          </button>
        </div>
      )}

      <main class="hub-workspace" id="hub-workspace">
        <!-- 网页端降级提示 -->
        <div id="web-banner" class="web-degraded-banner">
          <span>当前处于 Web 预览模式。硬件探测、模型下载与本地引擎仅在 AstroLib 桌面端可用。</span>
          <a href={`https://github.com/${DEFAULT_DESKTOP_RELEASE_REPO}/releases`} target="_blank" style="color: var(--hub-primary); text-decoration: underline; font-weight: 500;">
            下载官方桌面客户端
          </a>
        </div>

        <!-- 唯一全局设置宿主 -->
        <starlight-feature-toggles data-meta={metaJson} data-inline-hub="true" class="hub-ft-host" aria-label="AstroLib 全局控制中心与设置">
          <!-- 面板 0: 外观与排版偏好 -->
          <section id="panel-appearance" class="hub-panel active" data-panel-title="外观与排版偏好">
            <div class="panel-section-title">
              <div>
                <div>全局外观与阅读排版</div>
                <div class="panel-section-subtitle">Material You 动态主题色、Chrome 风格色盘与学术排版同步作用于全站所有视窗</div>
              </div>
              <button type="button" class="ft-m3-see-all-btn hub-reset-pill-btn" data-action="reset-defaults" title="恢复所有选项至默认配置">
                恢复默认设置
              </button>
            </div>

            <div class="ft-panel hub-ft-inline-panel" role="region" aria-label="外观与排版">
              <!-- 分组：界面与主题 -->
              {features.theme.enabled && (
                <div class="hub-card">
                  <div class="ft-section hub-ft-section">
                    <div class="ft-section-title">界面与主题</div>
                    <div class="ft-stack">
                      <div class="ft-m3-color-section hub-ft-color-section">
                        <!-- Chrome 风格外观模式分段控制 (浅色 / 深色 / 设备) -->
                        <div class="ft-theme-mode-segmented" role="radiogroup" aria-label="外观模式">
                          <button
                            type="button"
                            class="ft-mode-btn"
                            data-mode-val="light"
                            role="radio"
                            aria-checked="false"
                            title="浅色模式"
                          >
                            <svg class="ft-mode-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                              <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" />
                            </svg>
                            <span>浅色</span>
                          </button>
                          <button
                            type="button"
                            class="ft-mode-btn"
                            data-mode-val="dark"
                            role="radio"
                            aria-checked="false"
                            title="深色模式"
                          >
                            <svg class="ft-mode-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                              <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" />
                            </svg>
                            <span>深色</span>
                          </button>
                          <button
                            type="button"
                            class="ft-mode-btn"
                            data-mode-val="auto"
                            role="radio"
                            aria-checked="false"
                            title="设备模式（跟随系统自动切换）"
                          >
                            <svg class="ft-mode-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                              <path d="M4 6h16v10H4zm16-2H4c-1.11 0-2 .89-2 2v10c0 1.1.89 2 2 2H0v2h24v-2h-4c1.1 0 2-.9 2-2V6c0-1.11-.89-2-2-2z" />
                            </svg>
                            <span>设备</span>
                          </button>
                        </div>

                        <!-- 4x4 Chrome 风格精致色盘网格与取色器 -->
                        <div class="ft-chrome-swatches-grid">
                          {THEME_COLOR_PRESETS.map((preset) => (
                            <button
                              type="button"
                              class="ft-color-swatch ft-preset-swatch ft-chrome-color-tile"
                              data-m3-color={preset.id}
                              title={`主题色：${preset.label}`}
                              aria-label={`选择${preset.label}主题色`}
                            >
                              <svg class="ft-color-wheel-svg" viewBox="0 0 36 36" width="42" height="42">
                                <path d="M 18,18 L 18,0 A 18,18 0 0,1 33.588,9 Z" fill={preset.top}></path>
                                <path d="M 18,18 L 33.588,9 A 18,18 0 0,1 33.588,27 Z" fill={preset.right}></path>
                                <path d="M 18,18 L 33.588,27 A 18,18 0 0,1 18,36 Z" fill={preset.right}></path>
                                <path d="M 18,18 L 18,36 A 18,18 0 0,1 2.412,27 Z" fill={preset.left}></path>
                                <path d="M 18,18 L 2.412,27 A 18,18 0 0,1 2.412,9 Z" fill={preset.left}></path>
                                <path d="M 18,18 L 2.412,9 A 18,18 0 0,1 18,0 Z" fill={preset.top}></path>
                              </svg>
                              <div class="ft-tile-check-badge">
                                <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
                                </svg>
                              </div>
                            </button>
                          ))}

                          <!-- 第 16 项：自定义取色器 (Chrome Eyedropper) -->
                          <div
                            class="ft-chrome-color-tile ft-custom-color-tile"
                            data-action="open-custom-color"
                            role="button"
                            tabindex="0"
                            title="自定义 HEX 主题色"
                            aria-label="自定义主题色"
                          >
                            <input
                              type="color"
                              class="ft-color-native-input"
                              id="ft-custom-color-native-input"
                              value="#0b57d0"
                              aria-label="自定义主题色取色器"
                            />
                            <div class="ft-eyedropper-circle">
                              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                <path d="M20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-3.12 3.12-1.93-1.91-1.41 1.41 1.42 1.42L3 16.25V21h4.75l8.92-8.92 1.42 1.42 1.41-1.41-1.92-1.92 3.12-3.12c.4-.4.4-1.03.01-1.42zM6.92 19L5 17.08l8.06-8.06 1.92 1.92L6.92 19z"></path>
                              </svg>
                            </div>
                            <div class="ft-tile-check-badge">
                              <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
                              </svg>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- 主题平滑过渡动画 (M3 Switch) -->
                      <div class="ft-item-row">
                        <div class="ft-row-info">
                          <span class="ft-row-name">主题过渡</span>
                        </div>
                        <md-switch data-theme-transition aria-label="平滑主题过渡"></md-switch>
                      </div>

                      <!-- 加载动画风格 (Segmented Button) -->
                      <div class="ft-segment-wrapper ft-loading-style-wrapper">
                        <div class="ft-sub-label">加载动画风格</div>
                        <div class="ft-segment-track ft-grid-2 ft-loading-style-track">
                          <button type="button" class="ft-loading-style-btn" data-loading-style-val="morph" title="M3 灵动形变指示器（基于 @alerix/m3-loading-indicator，春生物理形变）">
                            灵动形变 (Morph)
                          </button>
                          <button type="button" class="ft-loading-style-btn" data-loading-style-val="linear" title="M3 经典线性进度条（水平流动，低干扰）">
                            经典线性 (Linear)
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              <!-- 分组：字体与排版偏好 -->
              {features.fonts.enabled && (
                <div class="hub-card hub-format-defaults-card">
                  <div class="ft-section hub-ft-section">
                    <div class="hub-format-card-header" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:6px;">
                      <div class="ft-section-title" style="margin-bottom:0;">默认排版配置（按书籍格式）</div>
                      <md-text-button id="hub-format-defaults-reset">恢复默认</md-text-button>
                    </div>
                    <p class="ft-settings-hint-text" style="margin:0 0 12px 0;">
                      分别为不同格式设定全局默认字体与版式；单本书籍可在阅读窗顶部「版式与视图」独立覆写且互不影响。
                    </p>
                    <md-chip-set class="ft-font-chip-set" id="hub-format-defaults-tabs" style="margin-bottom:14px;">
                      <md-filter-chip label="ABP 学术教材" data-format-tab="abp" selected></md-filter-chip>
                      <md-filter-chip label="EPUB 电子书" data-format-tab="epub"></md-filter-chip>
                    </md-chip-set>
                    <div class="ft-stack">
                      <!-- 正文字号大小滑块 -->
                      <div class="ft-segment-wrapper">
                        <div class="ft-slider-header">
                          <div class="ft-sub-label">默认正文字号</div>
                          <md-assist-chip class="ft-slider-val-chip" id="hub-format-font-size-val" label="15px (11.25 pt)"></md-assist-chip>
                        </div>
                        <div class="ft-slider-row">
                          <span class="ft-slider-mark min" title="紧凑精炼字阶 (9.75 pt / 13px)">A-</span>
                          <md-slider
                            class="ft-font-size-slider"
                            id="hub-format-font-size-slider"
                            min="13"
                            max="20"
                            step="1"
                            value="15"
                            labeled
                            ticks
                            aria-label="调整该格式默认正文字号"
                          ></md-slider>
                          <span class="ft-slider-mark max" title="醒目大字阶 (15.0 pt / 20px)">A+</span>
                        </div>
                      </div>

                      <!-- 西文字体预设 -->
                      <div class="ft-segment-wrapper">
                        <div class="ft-sub-label">默认西文 / 公式字体</div>
                        <md-chip-set class="ft-font-chip-set" id="hub-format-latin-chips">
                          {LATIN_PRESETS.map((p) => (
                            <md-filter-chip
                              class="ft-format-chip"
                              label={p.label}
                              data-format-latin={p.value}
                              selected={p.value === DEFAULT_PREF.latin ? true : undefined}
                            ></md-filter-chip>
                          ))}
                        </md-chip-set>
                      </div>

                      <!-- 中文字体预设 -->
                      <div class="ft-segment-wrapper">
                        <div class="ft-sub-label">默认正文中文字体</div>
                        <md-chip-set class="ft-font-chip-set" id="hub-format-cjk-chips">
                          {CJK_PRESETS.map((p) => (
                            <md-filter-chip
                              class="ft-format-chip"
                              label={p.label}
                              data-format-cjk={p.value}
                              selected={p.value === DEFAULT_PREF.cjk ? true : undefined}
                            ></md-filter-chip>
                          ))}
                        </md-chip-set>
                      </div>

                      <!-- 段前空两格 (M3 Switch) -->
                      <div class="ft-item-row">
                        <div class="ft-row-info">
                          <span class="ft-row-name">默认段前空两格</span>
                        </div>
                        <md-switch id="hub-format-indent-switch" aria-label="默认段落首行缩进两格" selected></md-switch>
                      </div>

                      <!-- 默认排版体裁 -->
                      <div class="ft-segment-wrapper">
                        <div class="ft-sub-label">默认排版体裁</div>
                        <md-chip-set class="ft-font-chip-set" id="hub-format-profile-chips">
                          <md-filter-chip label="学术排版" data-format-profile="academic" selected></md-filter-chip>
                          <md-filter-chip label="文学排版" data-format-profile="literary"></md-filter-chip>
                        </md-chip-set>
                      </div>

                      <!-- 句号形态 -->
                      <div class="ft-segment-wrapper">
                        <div class="ft-sub-label">默认句末标点形式</div>
                        <md-chip-set class="ft-font-chip-set" id="hub-format-punct-chips">
                          <md-filter-chip label="数理圆点 (．)" data-format-punct="dot" selected></md-filter-chip>
                          <md-filter-chip label="全角句号 (。)" data-format-punct="circle"></md-filter-chip>
                        </md-chip-set>
                      </div>

                      <!-- 默认阅读布局 -->
                      <div class="ft-segment-wrapper">
                        <div class="ft-sub-label">默认阅读布局</div>
                        <md-chip-set class="ft-font-chip-set" id="hub-format-layout-chips">
                          <md-filter-chip label="连续滚动" data-format-layout="scroll" selected></md-filter-chip>
                          <md-filter-chip label="单页翻阅" data-format-layout="paged-single"></md-filter-chip>
                          <md-filter-chip label="双栏对页" data-format-layout="paged-dual"></md-filter-chip>
                        </md-chip-set>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </section>

          <!-- 面板 1: 阅读设置 -->
          <section id="panel-reading" class="hub-panel" data-panel-title="阅读设置">
            <div class="panel-section-title">
              <div>
                <div>阅读设置</div>
                <div class="panel-section-subtitle">性能模式、正文中功能模块开关、缓存预载及 AI 助读服务配置</div>
              </div>
              <button type="button" class="ft-m3-see-all-btn hub-reset-pill-btn" data-action="reset-defaults" title="恢复所有选项至默认配置">
                恢复默认设置
              </button>
            </div>

            <div class="ft-panel hub-ft-inline-panel" role="region" aria-label="阅读设置">
              <!-- 核心模式：低性能模式 (M3 Switch) -->
              <div class="ft-lite-mode-card" id="ft-lite-mode-card">
                <div class="ft-lite-mode-main">
                  <div class="ft-lite-mode-icon-wrap" aria-hidden="true">
                    <svg class="ft-lite-mode-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                      <path d="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78L13.5 3h1l-1 7h3.5c.66 0 .44.62.33.82L11.5 21z" />
                    </svg>
                  </div>
                  <div class="ft-lite-mode-texts">
                    <div class="ft-lite-mode-title-row">
                      <span class="ft-lite-mode-title">低性能模式</span>
                      <span class="ft-lite-mode-badge" aria-live="polite">未开启</span>
                    </div>
                    <div class="ft-lite-mode-desc">
                      关闭预载、缓存与动效，为受限设备释放计算与内存，纯净阅读
                    </div>
                  </div>
                  <div class="ft-lite-mode-action">
                    <md-switch data-lite-mode aria-label="低性能模式"></md-switch>
                  </div>
                </div>
              </div>

              <!-- 阅读特性与缓存策略 -->
              <div class="hub-card">
                <div class="ft-section hub-ft-section">
                  <div class="ft-section-title">阅读交互与性能策略</div>
                  <div class="ft-stack">
                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">定理联动</span>
                      </div>
                      <md-switch data-feature-id="crossRef" aria-label="知识引用联动" disabled={!features.crossRef.enabled}></md-switch>
                    </div>

                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">公式操作</span>
                      </div>
                      <md-switch data-feature-id="formulaActions" aria-label="公式交互操作" disabled={!features.formulaActions.enabled}></md-switch>
                    </div>

                    <div class="ft-segment-wrapper ft-cache-wrapper">
                      <div class="ft-sub-label">页面内存缓存上限</div>
                      <div class="ft-segment-track ft-grid-4 ft-cache-track">
                        <button type="button" class="ft-cache-btn" data-cache-val="3" title="最多在内存中保留 3 篇已读章节（超限自动释放最旧页面）">3 篇</button>
                        <button type="button" class="ft-cache-btn" data-cache-val="5" title="最多在内存中保留 5 篇已读章节（推荐，平衡内存与回退速度）">5 篇</button>
                        <button type="button" class="ft-cache-btn" data-cache-val="10" title="最多在内存中保留 10 篇已读章节">10 篇</button>
                        <button type="button" class="ft-cache-btn" data-cache-val="20" title="最多在内存中保留 20 篇已读章节（大内存设备适用）">20 篇</button>
                      </div>
                    </div>

                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">左栏悬停预加载</span>
                      </div>
                      <md-switch data-sidebar-hover-prefetch aria-label="目录悬停预取" selected></md-switch>
                    </div>

                    {features.translation?.enabled && (
                      <>
                        <div class="ft-segment-wrapper ft-trans-mode-wrapper">
                          <div class="ft-sub-label">双语助读呈现方式</div>
                          <md-chip-set class="ft-trans-mode-chip-set">
                            <md-filter-chip class="ft-trans-mode-chip" label="侧边栏对照 (默认)" data-trans-mode-val="sidebar" selected={true}></md-filter-chip>
                            <md-filter-chip class="ft-trans-mode-chip" label="段落下方显示" data-trans-mode-val="inline"></md-filter-chip>
                          </md-chip-set>
                          <div class="ft-settings-hint-text">选择「段落下方显示」时，译文将直接呈现在各段落下方，不影响右侧侧边栏大纲。</div>
                        </div>

                        <div class="ft-segment-wrapper ft-trans-provider-wrapper" style="margin-top: 6px;">
                          <div class="ft-sub-label">助读翻译服务商</div>
                          <md-chip-set class="ft-trans-provider-chip-set" aria-label="选择助读翻译服务商">
                            <md-filter-chip class="ft-trans-provider-chip" label="Google 翻译 (免密)" data-trans-provider-val="google" selected={true}></md-filter-chip>
                            <md-filter-chip class="ft-trans-provider-chip ft-trans-provider-bupt hidden" label="北京邮电大学 (校内)" data-trans-provider-val="bupt" title="北京邮电大学「人人有算力」校内专属服务 · 非校园网环境不可用"></md-filter-chip>
                            <md-filter-chip class="ft-trans-provider-chip" label="智谱 GLM-4 (免费)" data-trans-provider-val="zhipu" title="智谱开放平台 GLM-4-Flash 官方免费模型 · 国内免翻直连"></md-filter-chip>
                            <md-filter-chip class="ft-trans-provider-chip" label="Google Gemini" data-trans-provider-val="gemini"></md-filter-chip>
                          </md-chip-set>
                          <div class="ft-settings-hint-text">随时切换段落与侧栏翻译源；智谱 GLM-4 与 Gemini 可在侧栏或 AI 栏配置 Key，北邮需校园网。</div>
                        </div>
                      </>
                    )}
                  </div>
                </div>
              </div>

              <!-- AI 与知识拓扑卡片 -->
              <div class="hub-card">
                <div class="ft-section hub-ft-section">
                  <div class="ft-section-title">AI 学术模型与知识拓扑</div>
                  <div class="ft-stack">
                    <div class="ft-sub-label" style="margin-top: 8px;">AI 功能</div>
                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">书内问答</span>
                      </div>
                      <md-switch data-feature-id="aiAsk" aria-label="AI 智能问答" disabled={!features.aiAsk.enabled}></md-switch>
                    </div>

                    <details class="ft-ai-advanced-group" data-ai-advanced-details>
                      <summary class="ft-ai-advanced-summary">
                        <div class="ft-ai-advanced-title-wrap">
                          <svg class="ft-ai-advanced-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                            <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 21l3.68-.99C9.48 20.63 10.71 21 12 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm0 16c-1.14 0-2.22-.29-3.17-.81l-.23-.13-2.33.63.63-2.27-.14-.24C6.27 15.22 6 13.65 6 12c0-3.31 2.69-6 6-6s6 2.69 6 6-2.69 6-6 6z"/>
                          </svg>
                          <span>问答与检索高级偏好</span>
                        </div>
                        <svg class="ft-ai-advanced-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </summary>
                      <div class="ft-ai-advanced-content">
                        <div class="ft-segment-wrapper">
                          <div class="ft-sub-label">回答方式</div>
                          <md-chip-set class="ft-ai-mode-chip-set">
                            <md-filter-chip class="ft-ai-mode-chip" label="检索本书 (默认)" data-ai-mode-val="retrieve" selected={true}></md-filter-chip>
                            <md-filter-chip class="ft-ai-mode-chip" label="深度讨论" data-ai-mode-val="discussion"></md-filter-chip>
                          </md-chip-set>
                          <div class="ft-settings-hint-text">「检索本书」优先结合教材片段溯源；「深度讨论」注重深入推导与全面讲解，需要时按需查书。</div>
                        </div>

                        <div class="ft-segment-wrapper">
                          <div class="ft-sub-label">来源卡片跳转</div>
                          <md-chip-set class="ft-ai-src-chip-set">
                            <md-filter-chip class="ft-ai-src-chip" label="新窗口打开" data-ai-src-val="new" selected={true}></md-filter-chip>
                            <md-filter-chip class="ft-ai-src-chip" label="本页平滑跳转" data-ai-src-val="same"></md-filter-chip>
                          </md-chip-set>
                        </div>

                        <div class="ft-segment-wrapper">
                          <div class="ft-slider-header">
                            <div class="ft-sub-label">检索片段 Top K</div>
                            <md-assist-chip class="ft-slider-val-chip ft-ai-topk-val-chip" label="8 条"></md-assist-chip>
                          </div>
                          <div class="ft-slider-row">
                            <span class="ft-slider-mark min">1</span>
                            <md-slider class="ft-ai-topk-slider" min="1" max="20" step="1" value="8" labeled ticks aria-label="检索片段数"></md-slider>
                            <span class="ft-slider-mark max">20</span>
                          </div>
                        </div>

                        <div class="ft-ai-form-row">
                          <md-outlined-text-field class="ft-ai-input ft-ai-maxctx-input" type="number" label="上下文上限 (字符)" min="-1" step="500" value="6000"></md-outlined-text-field>
                          <md-outlined-text-field class="ft-ai-input ft-ai-maxtok-input" type="number" label="单次最大 Token" min="-1" step="64" value="4096"></md-outlined-text-field>
                        </div>

                        <div class="ft-segment-wrapper">
                          <div class="ft-sub-label">问答窗口预设宽度</div>
                          <md-chip-set class="ft-ai-win-chip-set">
                            <md-filter-chip class="ft-ai-win-chip" label="紧凑 (460px)" data-ai-win-val="compact"></md-filter-chip>
                            <md-filter-chip class="ft-ai-win-chip" label="标准 (560px)" data-ai-win-val="standard" selected={true}></md-filter-chip>
                            <md-filter-chip class="ft-ai-win-chip" label="宽屏 (720px)" data-ai-win-val="wide"></md-filter-chip>
                            <md-filter-chip class="ft-ai-win-chip ft-ai-win-custom-chip" label="自定义" data-ai-win-val="custom"></md-filter-chip>
                          </md-chip-set>
                        </div>

                        <div class="ft-item-row ft-ai-collapse-row" style="padding: 0.4rem 0 0.2rem; border-top: 1px dashed var(--sl-color-hairline, rgba(125,125,125,0.2)); margin-top: 0.5rem;">
                          <div class="ft-row-info">
                            <span class="ft-row-name" style="font-size: 0.88rem;">折叠前序过程</span>
                            <span class="ft-row-desc" style="font-size: 0.76rem; color: var(--sl-color-text-secondary, #666);">除最新回复外，自动收起前面的思考与工具调用</span>
                          </div>
                          <md-switch class="ft-ai-collapse-preceding-toggle" aria-label="自动收起前序思考" selected></md-switch>
                        </div>

                        <div class="ft-item-row ft-ai-tools-summary-row" style="padding: 0.4rem 0 0.2rem; border-top: 1px dashed var(--sl-color-hairline, rgba(125,125,125,0.2)); margin-top: 0.35rem;">
                          <div class="ft-row-info">
                            <span class="ft-row-name" style="font-size: 0.88rem;">折叠工具探索总结</span>
                            <span class="ft-row-desc" style="font-size: 0.76rem; color: var(--sl-color-text-secondary, #666);">完成探索后将工具调用折叠为单行总结，避免遮挡正文</span>
                          </div>
                          <md-switch class="ft-ai-collapse-tools-summary-toggle" aria-label="折叠工具调用" selected></md-switch>
                        </div>

                        <div class="ft-item-row ft-ai-ref-chapter-row" style="padding: 0.4rem 0 0.2rem; border-top: 1px dashed var(--sl-color-hairline, rgba(125,125,125,0.2)); margin-top: 0.35rem;">
                          <div class="ft-row-info">
                            <span class="ft-row-name" style="font-size: 0.88rem;">侧载默认引用本章</span>
                            <span class="ft-row-desc" style="font-size: 0.76rem; color: var(--sl-color-text-secondary, #666);">侧载开启时自动附加正在阅读的本章内容</span>
                          </div>
                          <md-switch class="ft-ai-ref-chapter-toggle" aria-label="默认引用本章" selected></md-switch>
                        </div>
                      </div>
                    </details>

                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">Mermaid 图表</span>
                      </div>
                      <md-switch data-feature-id="mermaid" aria-label="Mermaid 图表" disabled={!features.mermaid.enabled}></md-switch>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 多窗口与分屏行为设置卡片 -->
              <div class="hub-card">
                <div class="ft-section hub-ft-section">
                  <div class="ft-section-title">多窗口与分屏行为</div>
                  <div class="ft-stack">
                    <div class="ft-segment-wrapper">
                      <div class="ft-sub-label">分屏中关闭正在展示的标签页时</div>
                      <md-chip-set id="hub-split-close-policy-chips">
                        <md-filter-chip label="自动补入后台标签 (默认)" data-split-policy="backfill" selected></md-filter-chip>
                        <md-filter-chip label="自动降级分屏模式" data-split-policy="collapse"></md-filter-chip>
                        <md-filter-chip label="保留空槽待选" data-split-policy="keep-empty"></md-filter-chip>
                      </md-chip-set>
                      <div class="ft-settings-hint-text">
                        选择当多窗格中的某个标签被关闭时，空出窗格的处理方式：由后台最近标签自动补位、随剩余数量自动收缩分屏，或保留空槽待选。
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </starlight-feature-toggles>

        <!-- 面板 2: 文献解析与研读 -->
        <SettingsIngestPanel />

        <!-- 面板 2b: Agent 与工具 -->
        <SettingsAgentPanel />

        <!-- 面板 3-6: 系统硬件自省、模型仓库、本地服务与扩展生态 -->
        <SettingsSystemPanels />
      </main>
    </div>
  </div>
</div>

<script>
  import '../../scripts/pages/settings-hub-client';
</script>
