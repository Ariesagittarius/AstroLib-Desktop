---
/**
 * src/components/desktop/SettingsHubContent.astro
 * ============================================================================
 * AstroLib 控制中心、阅读设置与扩展仓库共享核心视图
 * ============================================================================
 * 职责：
 * 1. 作为窗口内覆盖层模态框（Desktop In-Window Modal）与独立 /hub/ 路由的统一 UI；
 * 2. 完整保留原有 FeatureToggles 精心设计的 Material You (M3) 控件风格，并做自适应宽度适配；
 * 3. 分块组织：外观与排版偏好（原主题模式与 4x4 动态色轮 UI）、阅读设置（低性能/功能/AI）、
 *    硬件与自省环境、端侧模型仓库、本地服务与端口、扩展生态。
 * ============================================================================
 */
import { features } from '../../config/features.config.mjs';
import { DEFAULT_DESKTOP_RELEASE_REPO } from '../../config/release.config';
import { CJK_PRESETS, LATIN_PRESETS, DEFAULT_PREF } from '../../scripts/font-presets';
import { THEME_COLOR_PRESETS } from '../../themes/material-you/color-engine';
import '../../styles/components/feature-toggles.css';

interface Props {
  isOverlay?: boolean;
}

const { isOverlay = true } = Astro.props;
const isDev = import.meta.env.DEV;

const RUNTIME_IDS = new Set([
  'theme',
  'fonts',
  'crossRef',
  'formulaActions',
  'prewarm',
  'relationGraph',
  'mermaid',
  'epub',
  'aiAsk',
  'editor',
  'inspector',
  'pwa',
]);

const featureMeta = Object.entries(features).map(([id, f]) => ({
  id,
  label: f.label,
  build: f.enabled,
  runtime: RUNTIME_IDS.has(id),
  devOnly: f.devOnly,
}));
const metaJson = JSON.stringify(featureMeta);
---

<div class:list={['hub-root-shell', isOverlay ? 'hub-root-shell--overlay' : 'hub-root-shell--standalone']} data-hub-root>
  {!isOverlay && (
    <header class="hub-header">
      <div class="hub-header-left">
        <img src="/favicon.png" alt="AstroLib" class="hub-logo" />
        <span class="hub-title">控制中心与扩展仓库</span>
      </div>
      <div class="hub-header-right">
        <div id="env-badge" class="hub-env-pill">
          <span class="pulse-dot"></span>
          <span id="env-text">正在探活运行时...</span>
        </div>
      </div>
    </header>
  )}

  <div class="hub-container">
    <!-- 左侧导航栏 -->
    <nav class="hub-sidebar" aria-label="设置分类导航">
      {isOverlay && (
        <div class="hub-sidebar-top">
          <div class="hub-sidebar-brand">设置与控制中心</div>
          <div id="env-badge" class="hub-env-pill hub-env-pill--compact">
            <span class="pulse-dot"></span>
            <span id="env-text">正在探活运行时...</span>
          </div>
        </div>
      )}

      <div class="hub-nav-list">
        <button type="button" class="hub-nav-item active" data-target="panel-appearance">
          <span class="material-symbols-outlined hub-nav-icon">palette</span>
          <span>外观与排版偏好</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-reading">
          <span class="material-symbols-outlined hub-nav-icon">tune</span>
          <span>阅读设置</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-diagnostics">
          <span class="material-symbols-outlined hub-nav-icon">developer_board</span>
          <span>硬件与自省环境</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-models">
          <span class="material-symbols-outlined hub-nav-icon">model_training</span>
          <span>端侧模型仓库</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-services">
          <span class="material-symbols-outlined hub-nav-icon">dns</span>
          <span>本地服务与端口</span>
        </button>
        <button type="button" class="hub-nav-item" data-target="panel-extensions">
          <span class="material-symbols-outlined hub-nav-icon">extension</span>
          <span>扩展生态</span>
        </button>
      </div>
    </nav>

    <!-- 右侧主内容列 -->
    <div class="hub-main-column">
      {isOverlay && (
        <div class="hub-modal-topbar">
          <div class="hub-modal-topbar-meta">
            <span class="hub-modal-section-heading" id="hub-modal-section-heading">外观与排版偏好</span>
          </div>
          <button
            type="button"
            class="hub-overlay-close-btn"
            id="hub-overlay-close-btn"
            title="关闭设置 (Esc)"
            aria-label="关闭设置"
          >
            <span class="material-symbols-outlined" style="font-size: 20px;">close</span>
          </button>
        </div>
      )}

      <main class="hub-workspace" id="hub-workspace">
        <!-- 网页端降级提示 -->
        <div id="web-banner" class="web-degraded-banner">
          <span>当前处于 Web 预览模式。硬件探测、模型下载与本地引擎仅在 AstroLib 桌面端可用。</span>
          <a href={`https://github.com/${DEFAULT_DESKTOP_RELEASE_REPO}/releases`} target="_blank" style="color: var(--hub-primary); text-decoration: underline; font-weight: 500;">
            下载官方桌面客户端
          </a>
        </div>

        <!-- 面板 0: 外观与排版偏好（完整恢复原有 FeatureToggles 精心设计的 UI，自适应宽度） -->
        <section id="panel-appearance" class="hub-panel active" data-panel-title="外观与排版偏好">
          <div class="panel-section-title">
            <div>
              <div>全局外观与阅读排版</div>
              <div class="panel-section-subtitle">Material You 动态主题色、Chrome 风格色盘与学术排版同步作用于全站所有视窗</div>
            </div>
            <button type="button" class="ft-m3-see-all-btn hub-reset-pill-btn" data-action="reset-defaults" title="恢复所有选项至默认配置">
              恢复默认设置
            </button>
          </div>

          <starlight-feature-toggles data-meta={metaJson} data-inline-hub="true" class="hub-ft-host" aria-label="外观与排版设置">
            <div class="ft-panel hub-ft-inline-panel" role="region" aria-label="外观与排版">
              <!-- 分组：界面与主题（完整保留原有 Chrome 风格分段模式 + 4x4 三色圆盘 + 自定义取色器 + 过渡 + 加载动画） -->
              {features.theme.enabled && (
                <div class="hub-card">
                  <div class="ft-section hub-ft-section">
                    <div class="ft-section-title">界面与主题</div>
                    <div class="ft-stack">
                      <div class="ft-m3-color-section hub-ft-color-section">
                        <!-- Chrome 风格外观模式分段控制 (浅色 / 深色 / 设备) -->
                        <div class="ft-theme-mode-segmented" role="radiogroup" aria-label="外观模式">
                          <button
                            type="button"
                            class="ft-mode-btn"
                            data-mode-val="light"
                            role="radio"
                            aria-checked="false"
                            title="浅色模式"
                          >
                            <svg class="ft-mode-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                              <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z" />
                            </svg>
                            <svg class="ft-mode-check-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>浅色</span>
                          </button>
                          <button
                            type="button"
                            class="ft-mode-btn"
                            data-mode-val="dark"
                            role="radio"
                            aria-checked="false"
                            title="深色模式"
                          >
                            <svg class="ft-mode-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                              <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" />
                            </svg>
                            <svg class="ft-mode-check-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>深色</span>
                          </button>
                          <button
                            type="button"
                            class="ft-mode-btn"
                            data-mode-val="auto"
                            role="radio"
                            aria-checked="false"
                            title="遵循设备外观"
                          >
                            <svg class="ft-mode-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                              <path d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/>
                            </svg>
                            <svg class="ft-mode-check-icon hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>设备</span>
                          </button>
                        </div>

                        <div class="ft-chrome-swatches-grid">
                          {THEME_COLOR_PRESETS.map((preset) => (
                            <button
                              type="button"
                              class="ft-color-swatch ft-preset-swatch ft-chrome-color-tile"
                              data-m3-color={preset.id}
                              title={preset.label}
                              aria-label={preset.label}
                            >
                              <svg class="ft-color-wheel-svg" viewBox="0 0 36 36" width="42" height="42">
                                <path d="M 0 18 A 18 18 0 0 1 36 18 Z" fill={preset.top} />
                                <path d="M 0 18 A 18 18 0 0 0 18 36 L 18 18 Z" fill={preset.left} />
                                <path d="M 18 18 L 18 36 A 18 18 0 0 0 36 18 Z" fill={preset.right} />
                              </svg>
                              <span class="ft-tile-check-badge" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                  <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                              </span>
                              <md-ripple></md-ripple>
                            </button>
                          ))}

                          <!-- 第 16 项：自定义取色器 (Chrome Eyedropper) -->
                          <div
                            class="ft-chrome-color-tile ft-custom-color-tile"
                            data-action="open-custom-color"
                            role="button"
                            tabindex="0"
                            title="自定义 HEX 主题色"
                            aria-label="自定义主题色"
                          >
                            <input type="color" class="ft-color-native-input" data-action="custom-color-picker" value="#0b57d0" aria-label="自定义主题色" />
                            <div class="ft-eyedropper-circle">
                              <svg class="ft-eyedropper-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                <path d="M20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-3.12 3.12-1.93-1.91-1.41 1.41 1.42 1.42L3 16.25V21h4.75l8.92-8.92 1.42 1.42 1.41-1.41-1.92-1.92 3.12-3.12c.4-.4.4-1.03.01-1.42zM6.92 19L5 17.08l8.06-8.06 1.92 1.92L6.92 19z"/>
                              </svg>
                            </div>
                            <span class="ft-tile-check-badge" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                              </svg>
                            </span>
                            <md-ripple></md-ripple>
                          </div>
                        </div>
                      </div>

                      <!-- 主题平滑过渡动画 -->
                      <div class="ft-item-row">
                        <div class="ft-row-info">
                          <span class="ft-row-name">主题过渡</span>
                        </div>
                        <label class="ft-switch" title="切换平滑主题过渡">
                          <input type="checkbox" data-theme-transition />
                          <span class="ft-switch-slider"></span>
                        </label>
                      </div>

                      <!-- 加载动画风格 (Segmented Button) -->
                      <div class="ft-segment-wrapper ft-loading-style-wrapper">
                        <div class="ft-sub-label">加载动画风格</div>
                        <div class="ft-segment-track ft-grid-2 ft-loading-style-track">
                          <button type="button" class="ft-loading-style-btn" data-loading-style-val="morph" title="M3 灵动形变指示器（基于 @alerix/m3-loading-indicator，春生物理形变）">
                            灵动形变 (Morph)
                          </button>
                          <button type="button" class="ft-loading-style-btn" data-loading-style-val="native" title="Google 官方原生指示器（@material/web progress，经典圆环）">
                            官方原生 (Native)
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              <!-- 分组：字体 -->
              {features.fonts.enabled && (
                <div class="hub-card">
                  <div class="ft-section hub-ft-section">
                    <div class="ft-section-title">字体</div>
                    <div class="ft-stack">
                      <div class="ft-segment-wrapper">
                        <div class="ft-sub-label">中文</div>
                        <md-chip-set class="ft-font-chip-set ft-font-chip-set-cjk">
                          {CJK_PRESETS.map((opt) => (
                            <md-filter-chip
                              class={`ft-font-chip ft-cjk-${opt.value}`}
                              label={opt.label}
                              data-font-setting="cjk"
                              data-font-val={opt.value}
                              selected={opt.value === DEFAULT_PREF.cjk ? true : undefined}
                              has-selected-icon={opt.value === DEFAULT_PREF.cjk ? true : undefined}
                              title={opt.label}
                            ></md-filter-chip>
                          ))}
                        </md-chip-set>
                      </div>

                      <div class="ft-segment-wrapper">
                        <div class="ft-sub-label">英文与公式</div>
                        <md-chip-set class="ft-font-chip-set ft-font-chip-set-latin">
                          {LATIN_PRESETS.map((opt) => (
                            <md-filter-chip
                              class={`ft-font-chip ft-latin-${opt.value}`}
                              label={opt.label}
                              data-font-setting="latin"
                              data-font-val={opt.value}
                              selected={opt.value === DEFAULT_PREF.latin ? true : undefined}
                              has-selected-icon={opt.value === DEFAULT_PREF.latin ? true : undefined}
                              title={opt.label}
                            ></md-filter-chip>
                          ))}
                        </md-chip-set>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              <!-- 分组：排版 -->
              <div class="hub-card">
                <div class="ft-section hub-ft-section">
                  <div class="ft-section-title">排版</div>
                  <div class="ft-stack">
                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">段前空两格</span>
                      </div>
                      <label class="ft-switch" title="开启/关闭段落首行缩进两格">
                        <input type="checkbox" data-typography-indent checked />
                        <span class="ft-switch-slider"></span>
                      </label>
                    </div>

                    <div class="ft-segment-wrapper">
                      <div class="ft-sub-label">标点风格</div>
                      <md-chip-set class="ft-font-chip-set ft-punct-chip-set">
                        <md-filter-chip
                          class="ft-font-chip ft-punct-chip"
                          label="数理圆点 (．)"
                          data-punct-val="dot"
                          selected
                          has-selected-icon
                          title="大学数理专著标准实心圆点"
                        ></md-filter-chip>
                        <md-filter-chip
                          class="ft-font-chip ft-punct-chip"
                          label="中文句号 (。)"
                          data-punct-val="circle"
                          title="标准中文空心句号"
                        ></md-filter-chip>
                      </md-chip-set>
                    </div>

                    <div class="ft-segment-wrapper">
                      <div class="ft-slider-header">
                        <div class="ft-sub-label">调整正文字号</div>
                        <md-assist-chip
                          class="ft-slider-val-chip"
                          data-font-size-val
                          label="12 pt"
                          aria-label="当前正文字号"
                        ></md-assist-chip>
                      </div>
                      <div class="ft-slider-row">
                        <span class="ft-slider-mark min" title="标准小字阶 (10.5 pt / 14px)">A-</span>
                        <md-slider
                          class="ft-font-size-slider"
                          min="14"
                          max="22"
                          step="1"
                          value="16"
                          labeled
                          ticks
                          data-font-size-slider
                          aria-label="调整正文字号"
                        ></md-slider>
                        <span class="ft-slider-mark max" title="醒目大字阶 (16.5 pt / 22px)">A+</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </starlight-feature-toggles>
        </section>

        <!-- 面板 1: 阅读设置（严格按原有 FeatureToggles 分块方式组织，自适应宽度） -->
        <section id="panel-reading" class="hub-panel" data-panel-title="阅读设置">
          <div class="panel-section-title">
            <div>
              <div>阅读设置</div>
              <div class="panel-section-subtitle">性能模式、正文中功能模块开关、缓存预载及 AI 助读服务配置</div>
            </div>
            <button type="button" class="ft-m3-see-all-btn hub-reset-pill-btn" data-action="reset-defaults" title="恢复所有选项至默认配置">
              恢复默认设置
            </button>
          </div>

          <starlight-feature-toggles data-meta={metaJson} data-inline-hub="true" class="hub-ft-host" aria-label="阅读设置">
            <div class="ft-panel hub-ft-inline-panel" role="region" aria-label="阅读设置">
              <!-- 核心模式：低性能模式 -->
              <div class="ft-lite-mode-card" id="ft-lite-mode-card">
                <div class="ft-lite-mode-main">
                  <div class="ft-lite-mode-icon-wrap" aria-hidden="true">
                    <svg class="ft-lite-mode-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                      <path d="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78L13.5 3h1l-1 7h3.5c.66 0 .44.62.33.82L11.5 21z" />
                    </svg>
                  </div>
                  <div class="ft-lite-mode-texts">
                    <div class="ft-lite-mode-title-row">
                      <span class="ft-lite-mode-title">低性能模式</span>
                      <span class="ft-lite-mode-badge" aria-live="polite">未开启</span>
                    </div>
                    <div class="ft-lite-mode-desc">
                      关闭预载、缓存与动效，为受限设备释放计算与内存，纯净阅读
                    </div>
                  </div>
                  <div class="ft-lite-mode-action">
                    <label class="ft-switch" title="开启/关闭低性能模式">
                      <input type="checkbox" data-lite-mode />
                      <span class="ft-switch-slider"></span>
                    </label>
                  </div>
                </div>
              </div>

              <!-- Web 端 PWA 卡片（桌面客户端隐藏） -->
              {features.pwa?.enabled && (
                <div class="ft-pwa-card" id="ft-pwa-card">
                  <div class="ft-pwa-main">
                    <div class="ft-pwa-icon-wrap" aria-hidden="true">
                      <svg class="ft-pwa-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                        <path d="M20 17H4V5h16m0-2H4c-1.11 0-2 .89-2 2v12c0 1.1.89 2 2 2h4v2h8v-2h4c1.1 0 2-.9 2-2V5c0-1.11-.9-2-2-2m-3 8-5 5-5-5h3V7h4v4h3z"/>
                      </svg>
                    </div>
                    <div class="ft-pwa-texts">
                      <div class="ft-pwa-title-row">
                        <span class="ft-pwa-title">独立应用 (PWA)</span>
                        <span class="ft-pwa-badge" data-pwa-badge aria-live="polite">可安装</span>
                      </div>
                      <div class="ft-pwa-desc" data-pwa-desc>
                        在专用独立窗口中运行，享纯净沉浸学术阅读
                      </div>
                    </div>
                    <div class="ft-pwa-action">
                      <button type="button" class="ft-pwa-install-btn" data-pwa-install-btn title="安装 AstroLib 为独立应用">
                        <span class="ft-pwa-btn-text">安装应用</span>
                      </button>
                    </div>
                  </div>
                  <div class="ft-pwa-divider" aria-hidden="true"></div>
                  <div class="ft-pwa-pack-box">
                    <div class="ft-pwa-pack-header">
                      <div class="ft-pwa-pack-icon-wrap" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                          <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
                        </svg>
                      </div>
                      <div class="ft-pwa-pack-texts">
                        <div class="ft-pwa-title-row">
                          <span class="ft-pwa-pack-title">离线数据包</span>
                          <span class="ft-pwa-badge ft-pwa-pack-badge" data-pwa-pack-badge aria-live="polite">未下载</span>
                        </div>
                        <div class="ft-pwa-desc ft-pwa-pack-desc" data-pwa-pack-desc>
                          一键下载全站离线数据包，全量章节断网秒开，零网络依赖
                        </div>
                      </div>
                      <div class="ft-pwa-pack-actions">
                        <button type="button" class="ft-pwa-pack-btn ft-pwa-download-pack-btn" data-pwa-download-pack-btn title="下载全站离线数据包">
                          <span class="ft-pwa-pack-btn-text">下载离线包</span>
                        </button>
                        <button type="button" class="ft-pwa-pack-btn ft-pwa-clear-pack-btn hidden" data-pwa-clear-pack-btn title="清除本地已缓存离线数据包并释放存储">
                          <span>清空</span>
                        </button>
                      </div>
                    </div>
                    <div class="ft-pwa-progress-container hidden" data-pwa-progress-wrap>
                      <div class="ft-pwa-progress-bar-bg">
                        <div class="ft-pwa-progress-bar-fill" data-pwa-progress-fill style="width: 0%;"></div>
                      </div>
                      <div class="ft-pwa-progress-status-text" data-pwa-progress-text>准备下载...</div>
                    </div>
                  </div>
                </div>
              )}

              <!-- 分组：功能 -->
              <div class="hub-card">
                <div class="ft-section hub-ft-section">
                  <div class="ft-section-title">功能</div>
                  <div class="ft-stack">
                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">定理联动</span>
                      </div>
                      <label class="ft-switch" title="启用/禁用知识引用联动">
                        <input type="checkbox" data-feature-id="crossRef" disabled={!features.crossRef.enabled} />
                        <span class="ft-switch-slider"></span>
                      </label>
                    </div>

                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">公式操作</span>
                      </div>
                      <label class="ft-switch" title="启用/禁用公式操作">
                        <input type="checkbox" data-feature-id="formulaActions" disabled={!features.formulaActions.enabled} />
                        <span class="ft-switch-slider"></span>
                      </label>
                    </div>

                    <div class="ft-segment-wrapper ft-prewarm-wrapper">
                      <div class="ft-sub-label">后台章节预加载</div>
                      <div class="ft-segment-track ft-grid-5 ft-prewarm-track">
                        <button type="button" class="ft-prewarm-btn" data-prewarm-val="-1" title="空闲时在后台预加载全书章节">全书</button>
                        <button type="button" class="ft-prewarm-btn" data-prewarm-val="1" title="空闲时预加载前后各 1 页">前后1页</button>
                        <button type="button" class="ft-prewarm-btn" data-prewarm-val="2" title="空闲时预加载前后各 2 页">前后2页</button>
                        <button type="button" class="ft-prewarm-btn" data-prewarm-val="3" title="空闲时预加载前后各 3 页">前后3页</button>
                        <button type="button" class="ft-prewarm-btn" data-prewarm-val="0" title="关闭后台空闲预加载">关闭</button>
                      </div>
                    </div>

                    <div class="ft-segment-wrapper ft-cache-wrapper">
                      <div class="ft-sub-label">页面缓存上限</div>
                      <div class="ft-segment-track ft-grid-5 ft-cache-track">
                        <button type="button" class="ft-cache-btn" data-cache-val="3" title="内存中最多保留最近 3 页（节能模式）">3页</button>
                        <button type="button" class="ft-cache-btn" data-cache-val="5" title="内存中最多保留最近 5 页（标准平衡，默认推荐）">5页</button>
                        <button type="button" class="ft-cache-btn" data-cache-val="10" title="内存中最多保留最近 10 页（充裕内存）">10页</button>
                        <button type="button" class="ft-cache-btn" data-cache-val="20" title="内存中最多保留最近 20 页（超大缓存）">20页</button>
                        <button type="button" class="ft-cache-btn" data-cache-val="-1" title="不限制页面缓存数量（全保留）">不限</button>
                      </div>
                    </div>

                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">左栏悬停预加载</span>
                      </div>
                      <label class="ft-switch" title="鼠标指针悬停在左侧栏目录链接时提前预取页面（关闭后悬停目录不发起请求）">
                        <input type="checkbox" data-sidebar-hover-prefetch checked />
                        <span class="ft-switch-slider"></span>
                      </label>
                    </div>

                    {features.translation?.enabled && (
                      <>
                        <div class="ft-segment-wrapper ft-trans-mode-wrapper">
                          <div class="ft-sub-label">双语助读呈现方式</div>
                          <md-chip-set class="ft-font-chip-set ft-trans-mode-chip-set">
                            <md-filter-chip class="ft-font-chip" label="侧边栏对照 (默认)" data-trans-mode-val="sidebar" selected></md-filter-chip>
                            <md-filter-chip class="ft-font-chip" label="段落下方显示" data-trans-mode-val="inline"></md-filter-chip>
                          </md-chip-set>
                          <div class="ft-settings-hint-text">选择「段落下方显示」时，译文将直接呈现在各段落下方，不影响右侧侧边栏大纲。</div>
                        </div>

                        <div class="ft-segment-wrapper ft-trans-provider-wrapper" style="margin-top: 6px;">
                          <div class="ft-sub-label">助读翻译服务商</div>
                          <md-chip-set class="ft-font-chip-set ft-trans-provider-chip-set" aria-label="选择助读翻译服务商">
                            <md-filter-chip class="ft-font-chip" label="Google 翻译 (免密)" data-trans-provider-val="google" selected></md-filter-chip>
                            <md-filter-chip class="ft-font-chip ft-trans-provider-bupt hidden" label="北京邮电大学 (校内)" data-trans-provider-val="bupt" title="北京邮电大学「人人有算力」校内专属服务 · 非校园网环境不可用"></md-filter-chip>
                            <md-filter-chip class="ft-font-chip" label="智谱 GLM-4 (免费)" data-trans-provider-val="zhipu" title="智谱开放平台 GLM-4-Flash 官方免费模型 · 国内免翻直连"></md-filter-chip>
                            <md-filter-chip class="ft-font-chip" label="Google Gemini" data-trans-provider-val="gemini"></md-filter-chip>
                          </md-chip-set>
                          <div class="ft-settings-hint-text">随时切换段落与侧栏翻译源；智谱 GLM-4 与 Gemini 可在侧栏或 AI 栏配置 Key，北邮需校园网。</div>
                        </div>
                      </>
                    )}

                    {features.inspector.enabled && (
                      <div class="ft-item-row">
                        <div class="ft-row-info">
                          <div class="ft-row-title-line">
                            <span class="ft-row-name">模块速查</span>
                            <button type="button" class="ft-open-inspector-btn" data-inspector-trigger title="立即打开书籍模块速查 (Alt+M)">
                              Alt+M
                            </button>
                          </div>
                        </div>
                        <label class="ft-switch" title="启用/禁用模块速查">
                          <input type="checkbox" data-feature-id="inspector" />
                          <span class="ft-switch-slider"></span>
                        </label>
                      </div>
                    )}

                    {features.epub.enabled && (
                      <div class="ft-item-row">
                        <div class="ft-row-info">
                          <span class="ft-row-name">离线 EPUB</span>
                        </div>
                        <label class="ft-switch" title="启用/禁用 EPUB 离线下载">
                          <input type="checkbox" data-feature-id="epub" />
                          <span class="ft-switch-slider"></span>
                        </label>
                      </div>
                    )}
                  </div>
                </div>
              </div>

              <!-- 分组：AI 服务与功能 -->
              <div class="hub-card">
                <div class="ft-section hub-ft-section">
                  <div class="ft-section-title">AI</div>
                  <div class="ft-stack">
                    <div class="ft-ai-block">
                      <div class="ft-sub-label">
                        <span>模型提供商</span>
                        <button type="button" class="ft-ai-custom-toggle-btn" data-action="toggle-custom-model" title="添加/管理自定义 OpenAI 兼容模型">
                          + 自定义模型
                        </button>
                      </div>

                      <md-chip-set class="ft-font-chip-set ft-ai-provider-chip-set" aria-label="选择 AI 提供商">
                        <md-filter-chip class="ft-font-chip" label="Google Gemini" data-provider-id="gemini" selected></md-filter-chip>
                        <md-filter-chip class="ft-font-chip" label="DeepSeek" data-provider-id="deepseek"></md-filter-chip>
                        <md-filter-chip class="ft-font-chip" label="智谱 AI (GLM-4)" data-provider-id="zhipu" title="智谱开放平台 GLM-4-Flash 官方免费模型 · 国内直连"></md-filter-chip>
                        <md-filter-chip class="ft-font-chip ft-ai-provider-bupt hidden" label="北京邮电大学 (校内)" data-provider-id="bupt" title="北京邮电大学「人人有算力」校内大模型服务 · 非校园网环境不可用"></md-filter-chip>
                        <md-filter-chip class="ft-font-chip" label="自定义" data-provider-id="custom"></md-filter-chip>
                      </md-chip-set>

                      <div class="ft-ai-custom-form hidden">
                        <div class="ft-ai-form-row">
                          <md-outlined-text-field class="ft-ai-input ft-ai-custom-id" label="模型 ID" placeholder="如 gpt-4o 或 qwen-max" autocomplete="off"></md-outlined-text-field>
                          <md-outlined-text-field class="ft-ai-input ft-ai-custom-label" label="显示名称" placeholder="显示名称" autocomplete="off"></md-outlined-text-field>
                        </div>
                        <md-outlined-text-field class="ft-ai-input ft-ai-custom-ep" label="端点 URL" placeholder="https://api.openai.com/v1/chat/completions" autocomplete="off"></md-outlined-text-field>
                        <div class="ft-ai-custom-actions">
                          <button type="button" class="ft-ai-btn ft-ai-btn-ghost" data-action="cancel-custom-model">取消</button>
                          <button type="button" class="ft-ai-btn ft-ai-btn-primary" data-action="add-custom-model">保存模型</button>
                        </div>
                      </div>

                      <div class="ft-ai-field">
                        <div class="ft-ai-field-head">
                          <div class="ft-ai-test-status ft-ai-test-chip ft-m3-status-chip hidden" aria-live="polite" title="连接测试状态">
                            <svg class="ft-chip-icon ft-test-chip-icon-ok" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            </svg>
                            <svg class="ft-chip-icon ft-test-chip-icon-err hidden" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                              <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            </svg>
                            <m3-loading-indicator size="12" class="ft-chip-icon ft-test-chip-spinner hidden"></m3-loading-indicator>
                            <span class="ft-test-chip-text"></span>
                          </div>

                          <div class="ft-ai-key-badge ft-ai-key-chip ft-m3-status-chip" title="API Key 配置状态">
                            <svg class="ft-chip-icon" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            </svg>
                            <span class="ft-chip-label">未配置</span>
                          </div>
                        </div>
                        <div class="ft-ai-key-row">
                          <md-outlined-text-field
                            class="ft-ai-input ft-ai-key-input"
                            label="API Key"
                            type="password"
                            placeholder="填写 API Key"
                            autocomplete="off"
                          >
                            <md-icon-button
                              toggle
                              slot="trailing-icon"
                              type="button"
                              class="ft-ai-icon-btn ft-ai-key-reveal"
                              data-action="toggle-key-reveal"
                              touch-target="none"
                              aria-label="显示密钥"
                              aria-label-selected="隐藏密钥"
                              title="显示/隐藏密钥"
                            >
                              <md-icon class="ft-eye-open">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                  <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                                </svg>
                              </md-icon>
                              <md-icon slot="selected" class="ft-eye-closed">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                  <path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>
                                </svg>
                              </md-icon>
                            </md-icon-button>
                          </md-outlined-text-field>
                        </div>

                        <div class="ft-ai-campus-warning hidden" role="alert" style="font-size: 11px; color: var(--sl-color-amber-high, #e65100); background: rgba(255, 152, 0, 0.08); border-radius: 6px; padding: 6px 10px; margin-top: 6px; display: flex; align-items: center; gap: 6px; line-height: 1.4;">
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" style="flex-shrink: 0;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                          <span>未检测到校园网环境（非校园网或未连接校内 VPN 时，北邮校内模型暂不可用）</span>
                        </div>
                      </div>

                      <div class="ft-ai-field ft-ai-model-field" style="margin-top: 6px;">
                        <div class="ft-sub-label" style="margin-bottom: 4px;">
                          <span>选择模型</span>
                          <span class="ft-ai-provider-badge">Google Gemini</span>
                        </div>
                        <select class="ft-ai-select ft-ai-model-select"></select>
                      </div>

                      <div class="ft-ai-field">
                        <div class="ft-ai-endpoint-row">
                          <md-outlined-text-field
                            class="ft-ai-input ft-ai-endpoint-input"
                            label="API 端点"
                            type="text"
                            placeholder="https://generativelanguage.googleapis.com/..."
                            autocomplete="off"
                          >
                            <md-icon-button
                              slot="trailing-icon"
                              type="button"
                              class="ft-ai-test-icon-btn"
                              data-action="test-ai-connection"
                              touch-target="none"
                              aria-label="测试连接"
                              title="测试连接"
                            >
                              <md-icon class="ft-test-bolt-icon">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                  <path d="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78L13.5 3h1l-1 7h3.5c.66 0 .44.62.33.82L11.5 21z"/>
                                </svg>
                              </md-icon>
                              <m3-loading-indicator size="16" class="ft-test-spinner hidden"></m3-loading-indicator>
                            </md-icon-button>
                          </md-outlined-text-field>
                        </div>
                      </div>
                    </div>

                    <div class="ft-sub-label" style="margin-top: 8px;">AI 功能</div>
                    <div class="ft-item-row">
                      <div class="ft-row-info">
                        <span class="ft-row-name">书内问答</span>
                      </div>
                      <label class="ft-switch" title="启用/禁用 AI 智能问答">
                        <input type="checkbox" data-feature-id="aiAsk" disabled={!features.aiAsk.enabled} />
                        <span class="ft-switch-slider"></span>
                      </label>
                    </div>

                    <details class="ft-ai-advanced-group" data-ai-advanced-details>
                      <summary class="ft-ai-advanced-summary">
                        <div class="ft-ai-advanced-title-wrap">
                          <svg class="ft-ai-advanced-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                            <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 21l3.68-.99C9.48 20.63 10.71 21 12 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm0 16c-1.14 0-2.22-.29-3.17-.81l-.23-.13-2.33.63.63-2.27-.14-.24C6.27 15.22 6 13.65 6 12c0-3.31 2.69-6 6-6s6 2.69 6 6-2.69 6-6 6z"/>
                          </svg>
                          <span>问答与检索高级偏好</span>
                        </div>
                        <svg class="ft-ai-advanced-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </summary>
                      <div class="ft-ai-advanced-content">
                        <div class="ft-segment-wrapper">
                          <div class="ft-sub-label">回答方式</div>
                          <md-chip-set class="ft-font-chip-set ft-ai-mode-chip-set">
                            <md-filter-chip class="ft-font-chip" label="检索本书 (默认)" data-ai-mode-val="retrieve" selected></md-filter-chip>
                            <md-filter-chip class="ft-font-chip" label="深度讨论" data-ai-mode-val="discussion"></md-filter-chip>
                          </md-chip-set>
                          <div class="ft-settings-hint-text">「检索本书」优先结合教材片段溯源；「深度讨论」注重深入推导与全面讲解，需要时按需查书。</div>
                        </div>

                        <div class="ft-segment-wrapper">
                          <div class="ft-sub-label">来源卡片跳转</div>
                          <md-chip-set class="ft-font-chip-set ft-ai-src-chip-set">
                            <md-filter-chip class="ft-font-chip" label="新窗口打开" data-ai-src-val="new" selected></md-filter-chip>
                            <md-filter-chip class="ft-font-chip" label="本页平滑跳转" data-ai-src-val="same"></md-filter-chip>
                          </md-chip-set>
                        </div>

                        <div class="ft-segment-wrapper">
                          <div class="ft-slider-header">
                            <div class="ft-sub-label">检索片段 Top K</div>
                            <md-assist-chip class="ft-slider-val-chip ft-ai-topk-val-chip" label="8 条"></md-assist-chip>
                          </div>
                          <div class="ft-slider-row">
                            <span class="ft-slider-mark min">1</span>
                            <md-slider class="ft-ai-topk-slider" min="1" max="20" step="1" value="8" labeled ticks aria-label="检索片段数"></md-slider>
                            <span class="ft-slider-mark max">20</span>
                          </div>
                        </div>

                        <div class="ft-ai-form-row">
                          <md-outlined-text-field class="ft-ai-input ft-ai-maxctx-input" type="number" label="上下文上限 (字符)" min="-1" step="500" value="6000"></md-outlined-text-field>
                          <md-outlined-text-field class="ft-ai-input ft-ai-maxtok-input" type="number" label="单次最大 Token" min="-1" step="64" value="4096"></md-outlined-text-field>
                        </div>

                        <div class="ft-segment-wrapper">
                          <div class="ft-sub-label">问答窗口预设宽度</div>
                          <md-chip-set class="ft-font-chip-set ft-ai-win-chip-set">
                            <md-filter-chip class="ft-font-chip" label="紧凑 (460px)" data-ai-win-val="compact"></md-filter-chip>
                            <md-filter-chip class="ft-font-chip" label="标准 (560px)" data-ai-win-val="standard" selected></md-filter-chip>
                            <md-filter-chip class="ft-font-chip" label="宽屏 (720px)" data-ai-win-val="wide"></md-filter-chip>
                            <md-filter-chip class="ft-font-chip ft-ai-win-custom-chip" label="自定义" data-ai-win-val="custom"></md-filter-chip>
                          </md-chip-set>
                        </div>

                        <div class="ft-item-row ft-ai-collapse-row" style="padding: 0.4rem 0 0.2rem; border-top: 1px dashed var(--sl-color-hairline, rgba(125,125,125,0.2)); margin-top: 0.5rem;">
                          <div class="ft-row-info">
                            <span class="ft-row-name" style="font-size: 0.88rem;">折叠前序过程</span>
                            <span class="ft-row-desc" style="font-size: 0.76rem; color: var(--sl-color-text-secondary, #666);">除最新回复外，自动收起前面的思考与工具调用</span>
                          </div>
