<script>
  import '@material/web/button/filled-button.js';
  import '@material/web/button/outlined-button.js';
  import '@material/web/progress/linear-progress.js';
  import '@material/web/chips/chip-set.js';
  import '@material/web/chips/filter-chip.js';
  import '@material/web/chips/assist-chip.js';
  import '@material/web/slider/slider.js';
  import '@material/web/switch/switch.js';
  import '@material/web/textfield/outlined-text-field.js';
  import '@material/web/iconbutton/icon-button.js';
  import '@material/web/icon/icon.js';
  import '@material/web/ripple/ripple.js';
  import { initColorEngine } from '../../themes/material-you/color-engine';
  import { initFeatureToggles } from '../../scripts/feature-toggles';

  function initHubRuntime() {
    if ((window as any).__astrolibHubRuntimeInitialized) return;
    (window as any).__astrolibHubRuntimeInitialized = true;

    initColorEngine();
    initFeatureToggles();

    // 1. 选项卡切换逻辑
    const navItems = document.querySelectorAll<HTMLElement>('.hub-nav-item');
    const panels = document.querySelectorAll<HTMLElement>('.hub-panel');
    const sectionHeading = document.getElementById('hub-modal-section-heading');

    const activatePanel = (targetId: string) => {
      navItems.forEach((b) => {
        b.classList.toggle('active', b.getAttribute('data-target') === targetId);
      });
      panels.forEach((p) => {
        const isActive = p.id === targetId;
        p.classList.toggle('active', isActive);
        if (isActive && sectionHeading) {
          sectionHeading.textContent = p.getAttribute('data-panel-title') || '';
        }
      });
      const ws = document.getElementById('hub-workspace');
      if (ws) ws.scrollTop = 0;
    };

    navItems.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (targetId) activatePanel(targetId);
      });
    });

    window.addEventListener('astrolib:hub-select-panel', ((e: CustomEvent<{ panel?: string; section?: string }>) => {
      const targetPanel = e?.detail?.panel;
      if (targetPanel) activatePanel(targetPanel);
      if (e?.detail?.section === 'ai') {
        const aiSec = document.querySelector('#panel-reading .ft-section:has(.ft-ai-block)') as HTMLElement | null;
        if (aiSec) {
          setTimeout(() => {
            aiSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
            const adv = aiSec.querySelector<HTMLDetailsElement>('[data-ai-advanced-details]');
            if (adv) adv.open = true;
          }, 80);
        }
      }
    }) as EventListener);

    // 2. 桌面环境探测与模型状态水合
    const isElectron = Boolean((window as any).astrolib?.isElectron);
    const envBadge = document.getElementById('env-badge');
    const envText = document.getElementById('env-text');
    const webBanner = document.getElementById('web-banner');

    if (!isElectron) {
      if (envText) envText.textContent = 'Web 预览模式';
      webBanner?.classList.add('active');
      document.querySelectorAll<any>('#panel-diagnostics md-filled-button, #panel-models md-filled-button').forEach((b) => {
        b.disabled = true;
      });
    } else {
      const bridge = (window as any).astrolib;
      envBadge?.classList.add('active');
      if (envText) envText.textContent = `桌面运行时 v${bridge.appVersion || '0.0.1'}`;

      refreshDiagnostics();
      refreshModels();

      bridge.onModelProgress?.((p: any) => {
        updateModelProgressUI(p);
      });
    }

    async function refreshDiagnostics() {
      const bridge = (window as any).astrolib;
      if (!bridge) return;
      try {
        const d = await bridge.getEnvDiagnostics();
        const osEl = document.getElementById('diag-os');
        const cpuEl = document.getElementById('diag-cpu');
        const ramEl = document.getElementById('diag-ram');
        const diskEl = document.getElementById('diag-disk');
        const gpuEl = document.getElementById('diag-gpu');
        const cudaEl = document.getElementById('diag-cuda');
        const dmlEl = document.getElementById('diag-dml');
        const torchEl = document.getElementById('diag-torch');
        const pyEl = document.getElementById('diag-python');
        const hfEl = document.getElementById('diag-hf');

        if (osEl) osEl.textContent = `${d.platform} (${d.arch}) · ${d.osRelease}`;
        if (cpuEl) cpuEl.textContent = `${d.cpuModel.trim()} (${d.cpuCores} 核心)`;
        if (ramEl) ramEl.textContent = `总计 ${Math.round(d.totalMemMB / 1024)} GB (空闲约 ${Math.round(d.freeMemMB / 1024)} GB)`;
        if (diskEl) diskEl.textContent = `剩余约 ${d.diskFreeGB} GB`;

        if (gpuEl) {
          if (d.gpuName) {
            const vramText = d.gpuVramMB ? ` · ${Math.round(d.gpuVramMB / 1024)}GB VRAM` : '';
            gpuEl.textContent = `${d.gpuName}${vramText}`;
          } else {
            gpuEl.textContent = '未检出 NVIDIA 独立显卡';
          }
        }

        if (cudaEl) {
          cudaEl.textContent = d.hasCuda ? `就绪 (${d.cudaDeviceName || 'CUDA 硬件加速就绪'})` : '未检测到 CUDA / 无独立显卡';
        }
        if (dmlEl) {
          dmlEl.textContent = d.hasDirectML ? '支持 (DirectX 12 DirectML)' : '不支持';
        }
        if (torchEl) {
          torchEl.textContent = d.hasTorch ? `PyTorch 就绪${d.hasHfTransformers ? ' + Transformers' : ''}` : '未安装 PyTorch';
        }
        if (pyEl) {
          pyEl.textContent = d.pythonPath ? `${d.pythonPath} (v${d.pythonVersion || '3.x'})` : '未检测到可用 Python 环境';
        }
        if (hfEl) {
          hfEl.textContent = d.huggingFaceCacheDir || '默认 ~/.cache/huggingface/hub';
        }
      } catch (err) {
        console.error('诊断读取失败:', err);
      }
    }

    async function refreshModels() {
      const bridge = (window as any).astrolib;
      if (!bridge) return;
      try {
        const models = await bridge.getAvailableModels();
        for (const m of models) {
          updateModelCardStatus(m);
        }
      } catch (err) {
        console.error('模型状态刷新失败:', err);
      }
    }

    function updateModelCardStatus(m: any) {
      const isMinilm = m.id.startsWith('minilm');
      const badge = document.getElementById(`badge-${isMinilm ? 'minilm' : 'qwen'}`);
      const btn = document.getElementById(`btn-download-${isMinilm ? 'minilm' : 'qwen'}`) as HTMLButtonElement | null;
      if (!badge || !btn) return;

      const textEl = badge.querySelector('.status-text');

      if (m.status === 'ready') {
        badge.className = 'status-indicator ready';
        if (textEl) textEl.textContent = '已就绪';
        btn.textContent = '重新下载';
      } else if (m.status === 'needs_python') {
        badge.className = 'status-indicator warning';
        if (textEl) textEl.textContent = '缺少 Python';
        btn.textContent = '配置 Python';
        btn.disabled = true;
      } else if (m.status === 'downloading') {
        badge.className = 'status-indicator downloading';
        if (textEl) textEl.textContent = '下载中';
        btn.disabled = true;
      } else {
        badge.className = 'status-indicator';
        if (textEl) textEl.textContent = '未安装';
        btn.textContent = '下载模型';
        btn.disabled = false;
      }
    }

    function updateModelProgressUI(p: any) {
      const key = p.modelId.startsWith('minilm') ? 'minilm' : 'qwen';
      const box = document.getElementById(`progress-box-${key}`);
      const bar = document.getElementById(`progress-bar-${key}`) as any;
      const text = document.getElementById(`progress-text-${key}`);
      const meta = document.getElementById(`progress-meta-${key}`);
      const cancelBtn = document.getElementById(`btn-cancel-${key}`) as HTMLElement | null;
      const dlBtn = document.getElementById(`btn-download-${key}`) as HTMLButtonElement | null;

      if (p.status === 'downloading') {
        box?.classList.add('active');
        if (cancelBtn) cancelBtn.style.display = 'inline-block';
        if (dlBtn) dlBtn.disabled = true;
        if (bar) bar.value = p.percentage / 100;

        const speedMB = (p.speedBytesPerSec / (1024 * 1024)).toFixed(1);
        if (text) text.textContent = `下载中 (${(p.receivedBytes / (1024 * 1024)).toFixed(1)}MB / ${(p.totalBytes / (1024 * 1024)).toFixed(1)}MB)`;
        if (meta) meta.textContent = `${p.percentage}% · ${speedMB} MB/s · 剩余 ${p.etaSeconds}s`;
      } else if (p.status === 'completed' || p.status === 'cancelled' || p.status === 'error') {
        box?.classList.remove('active');
        if (cancelBtn) cancelBtn.style.display = 'none';
        if (dlBtn) dlBtn.disabled = false;
        refreshModels();
      }
    }

    document.getElementById('btn-recheck-env')?.addEventListener('click', () => refreshDiagnostics());
    document.getElementById('btn-select-python')?.addEventListener('click', async () => {
      const bridge = (window as any).astrolib;
      if (!bridge?.selectPythonPath) return;
      const selected = await bridge.selectPythonPath();
      if (selected && bridge.setCustomPythonPath) {
        await bridge.setCustomPythonPath(selected);
        await refreshDiagnostics();
        await refreshModels();
      }
    });

    document.getElementById('btn-download-minilm')?.addEventListener('click', async () => {
      await (window as any).astrolib?.startModelDownload?.('minilm-l12');
    });
    document.getElementById('btn-cancel-minilm')?.addEventListener('click', async () => {
      await (window as any).astrolib?.cancelModelDownload?.('minilm-l12');
    });
    document.getElementById('btn-recheck-minilm')?.addEventListener('click', () => refreshModels());

    document.getElementById('btn-download-qwen')?.addEventListener('click', async () => {
      await (window as any).astrolib?.startModelDownload?.('qwen3-embedding');
    });
    document.getElementById('btn-cancel-qwen')?.addEventListener('click', async () => {
      await (window as any).astrolib?.cancelModelDownload?.('qwen3-embedding');
    });
    document.getElementById('btn-recheck-qwen')?.addEventListener('click', () => refreshModels());
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHubRuntime);
  } else {
    initHubRuntime();
  }
</script>

