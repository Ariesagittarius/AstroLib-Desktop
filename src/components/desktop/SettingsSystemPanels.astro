---
/**
 * src/components/desktop/SettingsSystemPanels.astro
 * ============================================================================
 * System panels for Settings Hub: Diagnostics, Local Models, Services, Extensions
 * ============================================================================
 */
---

<!-- 面板 2: 硬件与自省环境 -->
<section id="panel-diagnostics" class="hub-panel" data-panel-title="硬件与自省环境">
  <div class="panel-section-title">
    <div>
      <div>系统硬件与运行环境</div>
      <div class="panel-section-subtitle">深度硬件自省与加速引擎就绪态</div>
    </div>
  </div>

  <div class="diag-grid">
    <div class="diag-card">
      <span class="diag-label">操作系统与平台</span>
      <span id="diag-os" class="diag-val">正在自检...</span>
    </div>
    <div class="diag-card">
      <span class="diag-label">中央处理器 (CPU)</span>
      <span id="diag-cpu" class="diag-val">正在自检...</span>
    </div>
    <div class="diag-card">
      <span class="diag-label">物理内存 (RAM)</span>
      <span id="diag-ram" class="diag-val">正在自检...</span>
    </div>
    <div class="diag-card">
      <span class="diag-label">磁盘可用空间</span>
      <span id="diag-disk" class="diag-val">正在自检...</span>
    </div>
    <div class="diag-card">
      <span class="diag-label">独立显卡 (GPU)</span>
      <span id="diag-gpu" class="diag-val">正在自检...</span>
    </div>
    <div class="diag-card">
      <span class="diag-label">NVIDIA CUDA 硬件加速</span>
      <span id="diag-cuda" class="diag-val">正在自检...</span>
    </div>
    <div class="diag-card">
      <span class="diag-label">DirectML 硬件加速</span>
      <span id="diag-dml" class="diag-val">正在自检...</span>
    </div>
    <div class="diag-card">
      <span class="diag-label">PyTorch &amp; Transformers</span>
      <span id="diag-torch" class="diag-val">正在自检...</span>
    </div>
    <div class="diag-card" style="grid-column: 1 / -1;">
      <span class="diag-label">当前生效 Python 解释器路径</span>
      <span id="diag-python" class="diag-val diag-val-code">正在自检...</span>
    </div>
    <div class="diag-card" style="grid-column: 1 / -1;">
      <span class="diag-label">HuggingFace 模型缓存目录</span>
      <span id="diag-hf" class="diag-val diag-val-code">正在自检...</span>
    </div>
  </div>

  <div style="display: flex; gap: 10px; margin-top: 6px; flex-wrap: wrap;">
    <md-filled-button id="btn-recheck-env">重新自检硬件与环境</md-filled-button>
    <md-outlined-button id="btn-select-python">选择自定义 Python 路径</md-outlined-button>
  </div>
</section>

<!-- 面板 3: 端侧模型仓库 -->
<section id="panel-models" class="hub-panel" data-panel-title="端侧模型仓库">
  <div class="panel-section-title">
    <div>
      <div>端侧轻量 Transformer 模型库</div>
      <div class="panel-section-subtitle">默认开启国内镜像加速 (hf-mirror.com)</div>
    </div>
  </div>

  <div class="hub-card" id="card-minilm">
    <div class="hub-card-header">
      <div class="hub-card-title-group">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span class="hub-card-title">MiniLM-L12 多语言通用向量</span>
          <span id="badge-minilm" class="status-indicator">
            <span class="status-dot"></span>
            <span class="status-text">检测中</span>
          </span>
        </div>
        <p class="hub-card-desc">
          端侧极轻量 384 维嵌入模型，专用于多语言教材段落语义对齐、双语对照与相似度热力图。
        </p>
      </div>
    </div>
    <div class="hub-meta-row">
      <span class="hub-meta-item">
        <span class="material-symbols-outlined hub-meta-icon">package_2</span>
        <span>体积: ~120 MB</span>
      </span>
      <span class="hub-meta-item">
        <span class="material-symbols-outlined hub-meta-icon">memory</span>
        <span>推理引擎: ONNX Runtime (CPU / DirectML)</span>
      </span>
      <span class="hub-meta-item">
        <span class="material-symbols-outlined hub-meta-icon">terminal</span>
        <span>硬件要求: 任意现代双核 CPU</span>
      </span>
    </div>
    <div id="progress-box-minilm" class="hub-progress-box">
      <div class="hub-progress-header">
        <span id="progress-text-minilm">正在连接国内镜像节点...</span>
        <span id="progress-meta-minilm">0% · 0 KB/s</span>
      </div>
      <md-linear-progress id="progress-bar-minilm" value="0"></md-linear-progress>
    </div>
    <div class="hub-actions">
      <md-filled-button id="btn-download-minilm">下载模型</md-filled-button>
      <md-outlined-button id="btn-cancel-minilm" style="display: none;">取消下载</md-outlined-button>
      <md-outlined-button id="btn-recheck-minilm">重新检测</md-outlined-button>
    </div>
  </div>

  <div class="hub-card" id="card-qwen">
    <div class="hub-card-header">
      <div class="hub-card-title-group">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span class="hub-card-title">Qwen3-Embedding-0.6B 高精学术模型</span>
          <span id="badge-qwen" class="status-indicator">
            <span class="status-dot"></span>
            <span class="status-text">检测中</span>
          </span>
        </div>
        <p class="hub-card-desc">
          0.6B 参数 1024 维学术级长文本嵌入模型，专用于多语种深层数理公式关联与 CUDA 硬件加速。
        </p>
      </div>
    </div>
    <div class="hub-meta-row">
      <span class="hub-meta-item">
        <span class="material-symbols-outlined hub-meta-icon">package_2</span>
        <span>体积: ~1.2 GB</span>
      </span>
      <span class="hub-meta-item">
        <span class="material-symbols-outlined hub-meta-icon">memory</span>
        <span>运行时: Python 3.10+ / PyTorch (CUDA)</span>
      </span>
      <span class="hub-meta-item">
        <span class="material-symbols-outlined hub-meta-icon">terminal</span>
        <span>硬件推荐: NVIDIA 独显 (RTX 系列)</span>
      </span>
    </div>
    <div id="progress-box-qwen" class="hub-progress-box">
      <div class="hub-progress-header">
        <span id="progress-text-qwen">正在准备下载进程...</span>
        <span id="progress-meta-qwen">0%</span>
      </div>
      <md-linear-progress id="progress-bar-qwen" value="0"></md-linear-progress>
    </div>
    <div class="hub-actions">
      <md-filled-button id="btn-download-qwen">下载模型</md-filled-button>
      <md-outlined-button id="btn-cancel-qwen" style="display: none;">取消下载</md-outlined-button>
      <md-outlined-button id="btn-recheck-qwen">重新检测</md-outlined-button>
    </div>
  </div>
</section>

<!-- 面板 4: 本地服务与端口 -->
<section id="panel-services" class="hub-panel" data-panel-title="本地服务与端口">
  <div class="panel-section-title">
    <div>
      <div>本地嵌入式服务引擎 (127.0.0.1)</div>
      <div class="panel-section-subtitle">离线静态服务与中间件总线</div>
    </div>
  </div>

  <div class="hub-card">
    <div class="service-item">
      <div>
        <div class="service-name">内嵌 Localhost HTTP 服务总线</div>
        <div id="service-port-desc" class="service-desc">监听中: 127.0.0.1 (固定 origin 62960 本地分流)</div>
      </div>
      <span class="status-indicator ready"><span class="status-dot"></span>运行中</span>
    </div>
    <div class="service-item">
      <div>
        <div class="service-name">章节 LaTeX / Typst 编译导出服务 (/__chapter_export__)</div>
        <div class="service-desc">基于本地 Typst / XeLaTeX 双编译器直出学术讲义与出版物 PDF</div>
      </div>
      <span class="status-indicator ready"><span class="status-dot"></span>已挂载</span>
    </div>
    <div class="service-item">
      <div>
        <div class="service-name">双语向量对齐与热力图计算 (/__bilingual__)</div>
        <div class="service-desc">基于 ONNX Runtime 原生驱动段落嵌入与二部图匈牙利对齐匹配</div>
      </div>
      <span class="status-indicator ready"><span class="status-dot"></span>已挂载</span>
    </div>
    <div class="service-item">
      <div>
        <div class="service-name">Gemini / BUPT AI 全双工中继代理 (/api/proxy/*)</div>
        <div class="service-desc">Node.js 原生流式代理，解决跨域与校园内网学术模型穿透</div>
      </div>
      <span class="status-indicator ready"><span class="status-dot"></span>已挂载</span>
    </div>
    <div class="service-item">
      <div>
        <div class="service-name">习题库本地源码热写回与社区题解 (/api/exercise)</div>
        <div class="service-desc">支持零刷新修改试题参数与题解答案本地即时持久化</div>
      </div>
      <span class="status-indicator ready"><span class="status-dot"></span>已挂载</span>
    </div>
  </div>
</section>

<!-- 面板 5: 扩展生态 -->
<section id="panel-extensions" class="hub-panel" data-panel-title="扩展生态">
  <div class="panel-section-title">
    <div>
      <div>功能插件与扩展中心</div>
      <div class="panel-section-subtitle">学术研读与数字化出版扩展生态</div>
    </div>
  </div>

  <div class="hub-card">
    <div class="service-item">
      <div>
        <div class="service-name">MinerU 学术文献与试卷摄取解析器</div>
        <div class="service-desc">端侧自动解析高清 PDF 讲义并重构为规范 MDX 教材章节与公式块</div>
      </div>
      <span class="status-indicator ready"><span class="status-dot"></span>核心内置</span>
    </div>
    <div class="service-item">
      <div>
        <div class="service-name">高校历年考研真题与期末试卷爬取插件</div>
        <div class="service-desc">自动聚合高校试题库并格式化为 AstroLib 交互练习册</div>
      </div>
      <span class="status-indicator warning"><span class="status-dot"></span>研发中</span>
    </div>
    <div class="service-item">
      <div>
        <div class="service-name">本地 Ollama / vLLM 大语言模型直连桥</div>
        <div class="service-desc">100% 离线运行 Qwen2.5-Math / DeepSeek 理科题解推理</div>
      </div>
      <span class="status-indicator"><span class="status-dot"></span>规划中</span>
    </div>
  </div>
</section>
