---
const PAGE_TITLE_ID = '_top';
import { renderTitleHtml } from '../utils/render-title.mjs';
import { collections } from '../config/collections.config.mjs';
import { features } from '../config/features.config.mjs';

const pathname = Astro.url.pathname;
const entry = Astro.locals.starlightRoute.entry;
const rawTitle = entry.data.title;
const titleHtml = renderTitleHtml(rawTitle);
const entryId = entry.id || '';
const entrySlug = entry.slug || '';

// 深度匹配当前路由所属图书及合集
let currentBook = null;
let currentCol = null;

for (const col of collections) {
  for (const book of col.books) {
    const pattern = `${col.slug}/${book.slug}`;
    if (pathname.includes(pattern) || entrySlug.includes(pattern) || entryId.includes(pattern)) {
      currentCol = col;
      currentBook = book;
      break;
    }
  }
  if (currentBook) break;
}

const stageSubjectLabel = [
  currentBook?.stageLabel,
  currentBook?.categoryLabel || currentBook?.subjectLabel
].filter(Boolean).join(' · ');

// 双语教材与多语言/多译本切换判定
interface VersionOption {
  id: string;
  label: string;
  url: string;
  isActive: boolean;
}

const isBilingualBook = Boolean(currentBook?.languages && currentBook.languages.length > 1);
const versionOptions: VersionOption[] = [];

if (isBilingualBook && currentCol && currentBook && currentBook.languages) {
  const prefix = `/collections/${currentCol.slug}/${currentBook.slug}`;

  // 1. 深度检测当前处于哪一个语言版本 (较长 prefix 优先匹配，防止 zh 截断 zh-wp)
  const sortedLangs = [...currentBook.languages].sort((a, b) => (b.pathPrefix?.length || 0) - (a.pathPrefix?.length || 0));
  let currentLang = sortedLangs.find(l => l.pathPrefix && (
    pathname.includes(`/${currentBook.slug}/${l.pathPrefix}/`) || 
    entrySlug.includes(`/${currentBook.slug}/${l.pathPrefix}/`)
  ));
  if (!currentLang) {
    currentLang = currentBook.languages.find(l => !l.pathPrefix || l.default) || currentBook.languages[0];
  }

  // 2. 提取当前章节的基础 key
  let baseChapterKey = '';
  if (currentLang.pathPrefix) {
    const match = pathname.match(new RegExp(`${prefix}/${currentLang.pathPrefix}/([^/?#]+)`));
    const rawSub = match ? match[1] : '';
    baseChapterKey = rawSub;
    if (currentBook.tocMapping) {
      const targetRelPath = `${currentLang.pathPrefix}/${rawSub}`;
      for (const [k, v] of Object.entries(currentBook.tocMapping)) {
        if (v === targetRelPath || (Array.isArray(v) && v.includes(targetRelPath))) {
          baseChapterKey = k;
          break;
        }
      }
    }
  } else {
    const match = pathname.match(new RegExp(`${prefix}/([^/?#]+)`));
    baseChapterKey = match ? match[1] : '';
  }

  // 3. 为所有配置的语言版本生成无缝跳转链接
  for (const lang of currentBook.languages) {
    const isActive = lang.id === currentLang.id;
    let targetSub = baseChapterKey;

    if (lang.pathPrefix) {
      targetSub = `${lang.pathPrefix}/${baseChapterKey}`;
      if (currentBook.tocMapping?.[baseChapterKey]) {
        const mapped = currentBook.tocMapping[baseChapterKey];
        if (Array.isArray(mapped)) {
          const found = mapped.find(p => p.startsWith(`${lang.pathPrefix}/`));
          if (found) targetSub = found;
        } else if (mapped.startsWith(`${lang.pathPrefix}/`)) {
          targetSub = mapped;
        }
      }
    }

    const url = targetSub ? `${prefix}/${targetSub}/` : `${prefix}/`;
    versionOptions.push({
      id: lang.id,
      label: lang.label,
      url,
      isActive,
    });
  }
}

const currentVersionOpt = versionOptions.find((o) => o.isActive) || versionOptions[0];
const targetVersionOptions = versionOptions.filter((o) => !o.isActive);
---

{currentBook ? (
  <header class="chapter-header">
    <h1 id={PAGE_TITLE_ID} class="chapter-title" set:html={titleHtml}></h1>

    <div class="chapter-meta-container" role="region" aria-label="教材出版信息">
      <md-chip-set class="chapter-meta-chip-set" role="list" aria-label="教材元数据">
        {currentBook.author && (
          <md-assist-chip label={currentBook.author} has-icon>
            <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
            </svg>
            <span class="m3-chip-text">{currentBook.author}</span>
          </md-assist-chip>
        )}

        {currentBook.publisher && (
          <md-assist-chip label={currentBook.publisher} has-icon>
            <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z" />
            </svg>
            <span class="m3-chip-text">{currentBook.publisher}</span>
          </md-assist-chip>
        )}

        {currentBook.title && (
          <md-assist-chip label={`《${currentBook.title}》`} has-icon>
            <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1zm0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5v11.5z" />
            </svg>
            <span class="m3-chip-text">《{currentBook.title}》</span>
          </md-assist-chip>
        )}

        {stageSubjectLabel && (
          <md-assist-chip label={stageSubjectLabel} has-icon>
            <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z" />
            </svg>
            <span class="m3-chip-text">{stageSubjectLabel}</span>
          </md-assist-chip>
        )}

        {versionOptions.map((opt) => (
          opt.isActive ? (
            <md-assist-chip
              class="chapter-lang-chip is-active"
              label={opt.label}
              has-icon
            >
              <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </svg>
              <span class="m3-chip-text">{opt.label}</span>
            </md-assist-chip>
          ) : (
            <a href={opt.url} class="bilingual-chip-link" title={`切换至 ${opt.label}`}>
              <md-assist-chip
                class="chapter-lang-chip"
                label={opt.label}
                has-icon
              >
                <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.87 15.07l-2.54-2.51.03-.08c1.74-1.94 2.98-4.17 3.71-6.49H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/>
                </svg>
                <span class="m3-chip-text">{opt.label}</span>
              </md-assist-chip>
            </a>
          )
        ))}

        {isBilingualBook && targetVersionOptions.length > 0 && (
          <div class="bilingual-trigger-wrapper">
            <md-assist-chip
              id="bilingual-in-page-trigger"
              class="chapter-compare-chip"
              label="双语段落关联对比"
              has-icon
              data-book-slug={currentBook.slug}
              data-source-id={currentVersionOpt?.id || 'src'}
              data-source-label={currentVersionOpt?.label || '当前语言'}
              data-targets={JSON.stringify(targetVersionOptions)}
              title="在本页面展开双栏排版对照与端侧语义关联分析"
            >
              <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M9.01 14H2v2h7.01v3L13 15.5 9.01 12v2zm5.98-1v-3H22V8h-7.01V5L11 8.5l3.99 3.5z"/>
              </svg>
              <span class="m3-chip-text">双语段落关联对比</span>
            </md-assist-chip>

            <!-- M3 Expressive Chrome 风格版本选择气泡菜单 (默认彻底隐藏) -->
            <div id="bilingual-version-popover" class="m3e-version-popover is-hidden" style="display: none;" role="menu" aria-label="选择对比版本">
              <div class="popover-header">
                <span class="popover-title">选择要对比的版本</span>
              </div>
              <div class="popover-list">
                {targetVersionOptions.map((t) => (
                  <button
                    type="button"
                    class="m3e-popover-item"
                    role="menuitem"
                    data-target-id={t.id}
                    data-target-label={t.label}
                    data-target-url={t.url}
                  >
                    <svg class="item-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                      <path fill="currentColor" d="M12.87 15.07l-2.54-2.51.03-.08c1.74-1.94 2.98-4.17 3.71-6.49H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/>
                    </svg>
                    <span class="item-label">{t.label}</span>
                  </button>
                ))}
              </div>
              <div class="popover-footer">
                <span class="popover-tip">系统将记住此选择，可在双栏顶栏随时切换</span>
              </div>
            </div>
          </div>
        )}

        {features.translation?.enabled && (
          <md-assist-chip
            class="chapter-translate-chip"
            data-translation-trigger
            label="双语助读 (Alt+Y)"
            has-icon
            title="开启本章双语对照与学术翻译 (Alt+Y)"
          >
            <md-icon slot="icon" aria-hidden="true">translate</md-icon>
            <span class="m3-chip-text">双语助读 (Alt+Y)</span>
          </md-assist-chip>
        )}
      </md-chip-set>
    </div>
  </header>
) : (
  <h1 id={PAGE_TITLE_ID} class="chapter-title" set:html={titleHtml}></h1>
)}

<style>
  @layer starlight.core {
    .chapter-header {
      display: flex;
      flex-direction: column;
      margin-top: 0;
      margin-bottom: 0;
      position: relative;
    }

    .chapter-header :is(#_top, .chapter-title) {
      margin-top: 0 !important;
      margin-bottom: 0.25rem !important;
      font-size: var(--sl-text-h1);
      line-height: 1.25 !important;
      font-weight: 700;
      color: var(--sl-color-white);
      letter-spacing: -0.015em;
    }

    .chapter-meta-container {
      display: flex;
      align-items: center;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0.45rem !important;
      border-bottom: 1px solid var(--sl-color-hairline);
    }

    .chapter-meta-chip-set {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      align-items: center;
      margin: 0 !important;
      padding: 0 !important;
      --md-assist-chip-container-shape: 9999px;
      --md-assist-chip-label-text-size: 0.775rem;
      --md-assist-chip-icon-size: 0.95rem;
      --md-assist-chip-outline-color: var(--sl-color-hairline);
      --md-assist-chip-outline-width: 1px;
      --md-assist-chip-container-color: transparent;
      --md-assist-chip-container-elevation: 0;
      --md-assist-chip-label-text-color: var(--sl-color-gray-2);
      --md-assist-chip-icon-color: var(--sl-color-gray-3);
    }

    .bilingual-chip-link {
      text-decoration: none !important;
      display: inline-flex;
      outline: none;
    }

    .chapter-lang-chip {
      --md-assist-chip-label-text-color: var(--sl-color-accent-high, #60a5fa) !important;
      --md-assist-chip-icon-color: var(--sl-color-accent-high, #60a5fa) !important;
      cursor: pointer !important;
    }

    .chapter-lang-chip:hover {
      --md-assist-chip-container-color: var(--sl-color-accent-low, rgba(59, 130, 246, 0.15)) !important;
    }

    .chapter-lang-chip.is-active {
      --md-assist-chip-container-color: var(--sl-color-accent-low, rgba(59, 130, 246, 0.15)) !important;
      --md-assist-chip-outline-color: var(--sl-color-accent, #3b82f6) !important;
      --md-assist-chip-label-text-color: var(--sl-color-accent-high, #60a5fa) !important;
      --md-assist-chip-icon-color: var(--sl-color-accent-high, #60a5fa) !important;
      font-weight: 600;
    }

    .chapter-compare-chip {
      --md-assist-chip-label-text-color: #38bdf8 !important;
      --md-assist-chip-icon-color: #38bdf8 !important;
      cursor: pointer !important;
    }

    .chapter-compare-chip:hover {
      --md-assist-chip-container-color: rgba(56, 189, 248, 0.15) !important;
    }

    .chapter-translate-chip {
      --md-assist-chip-label-text-color: var(--sl-color-accent-high, #60a5fa) !important;
      --md-assist-chip-icon-color: var(--sl-color-accent-high, #60a5fa) !important;
      cursor: pointer !important;
    }

    .chapter-translate-chip:hover {
      --md-assist-chip-container-color: var(--sl-color-accent-low, rgba(59, 130, 246, 0.15)) !important;
    }

    /* Fallback and styling before hydration */
    md-assist-chip:not(:defined) {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      height: 1.75rem;
      padding: 0 0.65rem;
      border-radius: 9999px;
      background-color: transparent;
      border: 1px solid var(--sl-color-hairline);
      color: var(--sl-color-gray-2);
      font-size: 0.775rem;
      font-weight: 500;
      box-sizing: border-box;
      box-shadow: none !important;
      cursor: default;
    }

    md-assist-chip:not(:defined) svg {
      width: 0.95rem;
      height: 0.95rem;
      color: var(--sl-color-gray-3);
      flex-shrink: 0;
    }

    /* When defined by Lit, the shadow DOM handles the label via `label` property,
       so hide the light DOM fallback text to prevent duplication */
    md-assist-chip:defined .m3-chip-text {
      display: none;
    }

    /* Strict bounding on all SVGs inside md-assist-chip */
    md-assist-chip svg {
      width: 0.95rem !important;
      height: 0.95rem !important;
      max-width: 0.95rem !important;
      max-height: 0.95rem !important;
      flex-shrink: 0;
    }
  }
</style>

<script>
  import '@material/web/chips/chip-set.js';
  import '@material/web/chips/assist-chip.js';
  import { inPageCompareController } from '../services/bilingual/in-page-compare-controller.ts';

  function initBilingualTrigger() {
    const trigger = document.getElementById('bilingual-in-page-trigger');
    const popover = document.getElementById('bilingual-version-popover');
    if (!trigger) return;

    const bookSlug = trigger.getAttribute('data-book-slug') || '';
    const sourceId = trigger.getAttribute('data-source-id') || '';
    const sourceLabel = trigger.getAttribute('data-source-label') || '';
    const targetsRaw = trigger.getAttribute('data-targets') || '[]';
    let availableTargets: any[] = [];
    try {
      availableTargets = JSON.parse(targetsRaw);
    } catch {
      availableTargets = [];
    }

    const storageKey = `astrolib_bilingual_target_${bookSlug}`;

    const launchTarget = (target: any) => {
      try {
        localStorage.setItem(storageKey, target.id);
      } catch {}
      if (popover) {
        popover.classList.add('is-hidden');
        popover.style.display = 'none';
      }
      trigger.classList.add('is-active');
      inPageCompareController.open({
        bookSlug,
        sourceId,
        sourceLabel,
        target,
        availableTargets,
      });
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();

      // 如果当前已经是激活状态，点击则是切换关闭
      if (inPageCompareController.getIsActive()) {
        inPageCompareController.close();
        trigger.classList.remove('is-active');
        return;
      }

      // 检查是否有记住的选择
      const savedTargetId = localStorage.getItem(storageKey);
      const matchedSaved = savedTargetId ? availableTargets.find((t: any) => t.id === savedTargetId) : null;

      if (matchedSaved) {
        // 已经有记住的选择：直接展开
        launchTarget(matchedSaved);
      } else if (availableTargets.length === 1) {
        // 只有一种可选目标：直接展开并记住
        launchTarget(availableTargets[0]);
      } else {
        // 首次且有多个选项：展示 M3E Chrome 风格气泡选单
        if (popover) {
          const isHidden = popover.style.display === 'none' || popover.classList.contains('is-hidden');
          if (isHidden) {
            popover.style.display = 'flex';
            popover.classList.remove('is-hidden');
          } else {
            popover.style.display = 'none';
            popover.classList.add('is-hidden');
          }
        }
      }
    });

    // 气泡选单项点击
    popover?.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest('.m3e-popover-item') as HTMLElement | null;
      if (!item) return;

      const targetId = item.getAttribute('data-target-id');
      const targetLabel = item.getAttribute('data-target-label');
      const targetUrl = item.getAttribute('data-target-url');

      if (targetId && targetLabel && targetUrl) {
        launchTarget({ id: targetId, label: targetLabel, url: targetUrl });
      }
    });

    // 点击外部关闭气泡
    document.addEventListener('click', (e) => {
      if (popover && popover.style.display !== 'none' && !popover.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
        popover.style.display = 'none';
        popover.classList.add('is-hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBilingualTrigger);
  } else {
    initBilingualTrigger();
  }
  document.addEventListener('astro:page-load', initBilingualTrigger);
</script>

