---
import M3Icon from '../../../components/m3/M3Icon.astro';
import '../../../styles/desktop/library.css';
---

<div class="fragment-library-container" id="fragment-library">

  <aside class="library-subnav" id="library-subnav">
    <div class="subnav-section">
      <div class="subnav-title">资源大类</div>
      <button type="button" class="subnav-item active" data-kind="all" id="shelf-btn-all">
        <M3Icon name="library_books" size={20} />
        <span class="subnav-label">全部资源</span>
        <span class="subnav-count" id="count-all">0</span>
      </button>

      <button type="button" class="subnav-item" data-kind="book" id="shelf-btn-books">
        <M3Icon name="menu_book" size={20} />
        <span class="subnav-label">书籍读物</span>
        <span class="subnav-count" id="count-books">0</span>
      </button>

      <button type="button" class="subnav-item" data-kind="paper" id="shelf-btn-papers">
        <M3Icon name="description" size={20} />
        <span class="subnav-label">文献论文</span>
        <span class="subnav-count" id="count-papers">0</span>
      </button>
    </div>

    <div class="subnav-divider"></div>

    <div class="subnav-section">
      <div class="subnav-header-row">
        <span class="subnav-title">我的书架</span>
        <button type="button" class="subnav-add-btn" id="btn-create-shelf" title="创建新书架">
          <M3Icon name="add" size={18} />
        </button>
      </div>

      <button type="button" class="subnav-item" data-shelf="unshelved" id="shelf-btn-unshelved">
        <M3Icon name="folder_open" size={20} />
        <span class="subnav-label">未分类</span>
      </button>

      <div class="subnav-custom-list" id="subnav-custom-list">

      </div>
    </div>
  </aside>

  <main class="library-main">

    <header class="library-toolbar">

      <div class="library-search-box">
        <M3Icon name="search" size={20} class="search-icon" />
        <input
          type="text"
          class="library-search-input"
          id="library-search-input"
          placeholder="搜索教材、专著、论文文献或著者..."
        />
      </div>

      <div class="library-toolbar__actions">

        <select class="library-sort-select" id="library-sort-select" title="排列方式">
          <option value="recent">最近研读</option>
          <option value="created">最新入库</option>
          <option value="progress">研读进度</option>
          <option value="title">名称排序</option>
        </select>

        <button type="button" class="library-token-btn" id="btn-official-catalog" title="从官方 Release 获取教材 .abp">
          <M3Icon name="cloud_download" size={16} />
          <span>官方书库</span>
        </button>

        <md-filled-button id="btn-library-upload" title="支持多选或拖放 .abp / .epub 书籍与 .pdf 文献">
          <M3Icon name="upload" size={18} slot="icon" />
          <span>导入书籍 / 文献</span>
        </md-filled-button>
        <input type="file" id="library-file-input" accept=".abp,.epub,.pdf" multiple style="display: none;" />

        <div class="library-view-toggle">
          <button type="button" class="view-btn active" id="btn-view-grid" title="网格视图">
            <M3Icon name="grid_view" size={18} />
          </button>
          <button type="button" class="view-btn" id="btn-view-list" title="列表视图">
            <M3Icon name="view_list" size={18} />
          </button>
        </div>
      </div>
    </header>

    <div class="library-chips-row">
      <md-chip-set class="library-chip-set" id="library-chip-set">
        <md-filter-chip class="lib-filter-chip" label="全部领域" data-subject="all" selected></md-filter-chip>
        <md-filter-chip class="lib-filter-chip" label="数学" data-subject="math"></md-filter-chip>
        <md-filter-chip class="lib-filter-chip" label="物理" data-subject="physics"></md-filter-chip>
        <md-filter-chip class="lib-filter-chip" label="计算机科学" data-subject="cs"></md-filter-chip>
        <md-filter-chip class="lib-filter-chip" label="通信工程" data-subject="telecom"></md-filter-chip>
        <md-filter-chip class="lib-filter-chip" label="文学与文化" data-subject="literature"></md-filter-chip>
        <md-filter-chip class="lib-filter-chip" label="轻小说与二次元" data-subject="acg"></md-filter-chip>
        <md-filter-chip class="lib-filter-chip" label="艺术与美学" data-subject="aesthetics"></md-filter-chip>
        <md-filter-chip class="lib-filter-chip" label="综合读物" data-subject="general"></md-filter-chip>
        <md-filter-chip class="lib-filter-chip" label="学术论文" data-subject="paper"></md-filter-chip>
      </md-chip-set>
    </div>

    <div class="library-status-banner" id="library-status-banner" style="display: none;">
      <div class="banner-content">
        <M3Icon name="sync" size={18} class="banner-spinner" id="banner-status-icon" />
        <span class="banner-text" id="library-banner-text">正在上传文件...</span>
      </div>
      <button type="button" class="banner-close-btn" id="btn-close-banner" title="关闭通知">
        <M3Icon name="close" size={16} />
      </button>
    </div>

    <div class="library-content-scroll" id="library-content-scroll">
      <div class="library-entities-grid" id="library-entities-grid">

        <div class="library-loading-placeholder">
          <div class="lib-spinner"></div>
          <p>正在读取书目与学术文献库...</p>
        </div>
      </div>
    </div>
  </main>

  <div class="official-catalog-backdrop" id="official-catalog-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="official-catalog-title">
    <div class="official-catalog-surface">
      <header class="official-catalog-header">
        <div>
          <h2 id="official-catalog-title">官方教材发行目录</h2>
          <p class="official-catalog-sub" id="official-catalog-source">GitHub Releases · 模式 A 零内置壳按需安装</p>
        </div>
        <div class="official-catalog-header-actions">
          <md-outlined-button id="btn-official-refresh">刷新目录</md-outlined-button>
          <md-text-button id="btn-official-close">关闭</md-text-button>
        </div>
      </header>
      <div class="official-catalog-body" id="official-catalog-body">
        <div class="library-loading-placeholder">
          <div class="lib-spinner"></div>
          <p>正在连接官方发行清单...</p>
        </div>
      </div>
    </div>
  </div>

  <md-dialog id="dialog-mineru-token-required">
    <div slot="headline">需要先配置 MinerU API Token</div>
    <div slot="content" class="lib-dialog-body">
      <div>当前文献解析通道为官方云端 MinerU，但未检测到有效的 API Token。以下 PDF 文献已阻断处理：</div>
      <ul class="lib-dialog-file-list" id="token-dialog-blocked-files"></ul>
      <div>如已上传 .abp 教材包，教材部分不受影响。请前往全局设置填写 Token 或切换解析通道。</div>
    </div>
    <div slot="actions">
      <md-text-button id="btn-token-dialog-cancel">稍后配置</md-text-button>
      <md-filled-button id="btn-token-dialog-goto-settings">前往全局设置填写</md-filled-button>
    </div>
  </md-dialog>

  <md-dialog id="dialog-pdf-page-range">
    <div slot="headline">指定文献解析页码范围</div>
    <div slot="content" class="lib-dialog-body">
      <div>以下 PDF 文献总页数超过单次 MinerU 解析上限（200 页），请为每篇文献输入需要提取解析的页码范围：</div>
      <div id="page-range-tasks-container"></div>
    </div>
    <div slot="actions">
      <md-text-button id="btn-page-range-cancel">暂不解析</md-text-button>
      <md-filled-button id="btn-page-range-confirm">确认并开始解析</md-filled-button>
    </div>
  </md-dialog>
</div>

<script>import '@material/web/dialog/dialog.js';
  import '@material/web/textfield/outlined-text-field.js';
  import '@material/web/button/filled-button.js';
  import '@material/web/button/filled-tonal-button.js';
  import '@material/web/button/outlined-button.js';
  import '@material/web/button/text-button.js';
  import '@material/web/iconbutton/icon-button.js';
  import type { UnifiedReadingEntity, LibraryShelf } from '../../../types/library-entity';
  import { libraryClient } from '../core/library-client';
  import {
    handleMixedFileUploads,
    reparseEntityTask,
    type IngestPipelineCallbacks,
  } from '../core/ingest-upload-pipeline';
  import { promptOversizedPdfPageRanges, showMissingTokenDialog } from '../core/library-dialogs';
  import {
    buildAcademicDefaultCoverHtml,
    getLocalCoverFallbackCandidates,
  } from '../core/default-cover';

  class DesktopLibraryController {
    private entities: UnifiedReadingEntity[] = [];
    private shelves: LibraryShelf[] = [];
    private activeKind: string = 'all';
    private activeSubject: string = 'all';
    private activeShelf: string | null = null;
    private searchQuery: string = '';
    private sortKey: string = 'recent';
    private isListView: boolean = false;
    private pollTimer: number | null = null;

    private gridEl: HTMLElement | null = null;
    private scrollEl: HTMLElement | null = null;
    private searchInput: HTMLInputElement | null = null;
    private fileInput: HTMLInputElement | null = null;
    private bannerEl: HTMLElement | null = null;
    private bannerText: HTMLElement | null = null;

    constructor() {
      this.gridEl = document.getElementById('library-entities-grid');
      this.scrollEl = document.getElementById('library-content-scroll');
      this.searchInput = document.getElementById('library-search-input') as HTMLInputElement;
      this.fileInput = document.getElementById('library-file-input') as HTMLInputElement;
      this.bannerEl = document.getElementById('library-status-banner');
      this.bannerText = document.getElementById('library-banner-text');

      this.initEventListeners();
      this.fetchData();
    }

    private getPipelineCallbacks(): IngestPipelineCallbacks {
      return {
        onStatus: (msg, autoHideMs = 0, isError = false) => this.showBanner(msg, autoHideMs, isError),
        onRefreshLibrary: () => this.fetchData(true),
        onMissingMineruToken: (blockedNames) => showMissingTokenDialog(blockedNames),
        onPromptOversizedPages: (tasks) => promptOversizedPdfPageRanges(tasks),
      };
    }

    private initEventListeners() {

      document.querySelectorAll('.subnav-item[data-kind]').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.subnav-item').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          this.activeKind = btn.getAttribute('data-kind') || 'all';
          this.activeShelf = null;
          this.render();
        });
      });

      const filterChips = document.querySelectorAll('.lib-filter-chip');
      filterChips.forEach((chip: any) => {
        chip.addEventListener('click', () => {
          filterChips.forEach((c: any) => {
            if (c !== chip) c.selected = false;
          });
          chip.selected = true;
          this.activeSubject = chip.getAttribute('data-subject') || 'all';
          this.render();
        });
      });

      this.searchInput?.addEventListener('input', () => {
        this.searchQuery = (this.searchInput?.value || '').trim().toLowerCase();
        this.render();
      });

      document.getElementById('library-sort-select')?.addEventListener('change', (e: any) => {
        this.sortKey = e.target.value;
        this.render();
      });

      document.getElementById('btn-view-grid')?.addEventListener('click', () => {
        document.getElementById('btn-view-grid')?.classList.add('active');
        document.getElementById('btn-view-list')?.classList.remove('active');
        this.isListView = false;
        this.render();
      });
      document.getElementById('btn-view-list')?.addEventListener('click', () => {
        document.getElementById('btn-view-list')?.classList.add('active');
        document.getElementById('btn-view-grid')?.classList.remove('active');
        this.isListView = true;
        this.render();
      });

      document.getElementById('btn-library-upload')?.addEventListener('click', () => {
        this.fileInput?.click();
      });
      document.getElementById('btn-official-catalog')?.addEventListener('click', () => {
        this.openOfficialCatalog();
      });
      document.getElementById('btn-official-close')?.addEventListener('click', () => {
        this.closeOfficialCatalog();
      });
      document.getElementById('btn-official-refresh')?.addEventListener('click', () => {
        this.loadOfficialCatalog();
      });
      document.getElementById('official-catalog-modal')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) this.closeOfficialCatalog();
      });

      this.fileInput?.addEventListener('change', (e: any) => {
        const files = e.target.files as FileList | null;
        if (files && files.length > 0) {
          void handleMixedFileUploads(files, this.getPipelineCallbacks());
        }
        this.fileInput!.value = '';
      });

      if (this.scrollEl) {
        this.scrollEl.addEventListener('dragover', (e) => {
          if (e.dataTransfer?.types?.includes('Files')) {
            e.preventDefault();
            this.scrollEl!.classList.add('is-drag-over');
          }
        });
        this.scrollEl.addEventListener('dragleave', (e) => {
          if (e.target === this.scrollEl) {
            this.scrollEl!.classList.remove('is-drag-over');
          }
        });
        this.scrollEl.addEventListener('drop', (e) => {
          this.scrollEl!.classList.remove('is-drag-over');
          const files = e.dataTransfer?.files;
          if (files && files.length > 0) {
            e.preventDefault();
            void handleMixedFileUploads(files, this.getPipelineCallbacks());
          }
        });
      }

      document.getElementById('btn-close-banner')?.addEventListener('click', () => {
        this.hideBanner();
      });

      document.getElementById('btn-create-shelf')?.addEventListener('click', async () => {
        const name = prompt('请输入新书架名称：');
        if (name && name.trim()) {
          await this.createShelf(name.trim());
        }
      });

      window.addEventListener('astrolib:library-updated', () => {
        void this.fetchData(true);
      });
      window.addEventListener('message', (e) => {
        if (e.data?.type === 'ASTROLIB_LIBRARY_UPDATED') {
          void this.fetchData(true);
        }
      });
    }

    private toThumbCoverUrl(cover?: string): string {
      if (!cover) return '/favicon.png';
      const match = cover.match(/^\/covers\/([^/?#]+)\.(jpg|jpeg|png|webp)$/i);
      return match ? `/covers/thumbs/${match[1]}.webp` : cover;
    }

    private predecodedCoverUrls = new Set<string>();

    private scheduleTopCoverPredecode() {
      const urls: string[] = [];
      for (const item of this.entities) {
        if (item.kind !== 'book' || !item.cover) continue;
        const thumbUrl = this.toThumbCoverUrl(item.cover);
        if (!this.predecodedCoverUrls.has(thumbUrl)) {
          this.predecodedCoverUrls.add(thumbUrl);
          urls.push(thumbUrl);
          if (urls.length >= 12) break;
        }
      }
      if (urls.length === 0) return;

      const run = () => {
        for (const url of urls) {
          const img = new Image();
          img.decoding = 'async';
          img.src = url;
          if (typeof img.decode === 'function') {
            img.decode().catch(() => {});
          }
        }
      };

      const w = window as any;
      if (typeof w.requestIdleCallback === 'function') {
        w.requestIdleCallback(run, { timeout: 900 });
      } else {
        setTimeout(run, 300);
      }
    }

    private async fetchData(forceRefresh = false, silent = false) {
      try {
        const [entitiesRes, shelvesRes] = await Promise.all([
          libraryClient.getEntities(forceRefresh),
          libraryClient.getShelves(),
        ]);

        const prevSig = this.entities
          .map((e) => `${e.id}:${e.status}:${e.statusMessage || ''}`)
          .join('|');
        const nextSig = entitiesRes
          .map((e) => `${e.id}:${e.status}:${e.statusMessage || ''}`)
          .join('|');

        this.entities = entitiesRes;
        this.shelves = shelvesRes;
        this.syncBackgroundPolling();

        if (silent && prevSig === nextSig) {
          return;
        }

        this.updateCounts();
        this.renderShelves();
        this.render();
        this.scheduleTopCoverPredecode();
      } catch (err) {
        if (!silent) {
          console.error('[FragmentLibrary] 获取书库失败:', err);
          if (this.gridEl) {
            this.gridEl.innerHTML = `<div class="library-empty">加载书库数据失败: ${err}</div>`;
          }
        }
      }
    }

    private syncBackgroundPolling() {
      const hasProcessing = this.entities.some((e) => e.status === 'processing');
      if (hasProcessing && this.pollTimer === null) {
        this.pollTimer = window.setInterval(() => {
          void this.fetchData(true, true);
        }, 2500);
      } else if (!hasProcessing && this.pollTimer !== null) {
        clearInterval(this.pollTimer);
        this.pollTimer = null;
      }
    }

    private updateCounts() {
      const elAll = document.getElementById('count-all');
      const elBooks = document.getElementById('count-books');
      const elPapers = document.getElementById('count-papers');

      if (elAll) elAll.textContent = String(this.entities.length);
      if (elBooks) elBooks.textContent = String(this.entities.filter((e) => e.kind === 'book').length);
      if (elPapers) elPapers.textContent = String(this.entities.filter((e) => e.kind === 'paper').length);
    }

    private renderShelves() {
      const container = document.getElementById('subnav-custom-list');
      if (!container) return;
      container.innerHTML = '';

      this.shelves.forEach((s) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `subnav-item ${this.activeShelf === s.id ? 'active' : ''}`;
        btn.innerHTML = `
          <span class="material-symbols-outlined" style="font-size: 20px;">folder</span>
          <span class="subnav-label">${s.name}</span>
        `;
        btn.addEventListener('click', () => {
          document.querySelectorAll('.subnav-item').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          this.activeShelf = s.id;
          this.activeKind = 'all';
          this.render();
        });
        container.appendChild(btn);
      });
    }

    private async createShelf(name: string) {
      try {
        const shelf = await libraryClient.createShelf(name);
        this.shelves.push(shelf);
        this.renderShelves();
      } catch (e: any) {
        alert('创建书架失败: ' + (e.message || e));
      }
    }

    private async deletePaper(item: UnifiedReadingEntity) {
      const taskId = item.metadata?.taskId;
      if (!taskId) return;
      try {
        await libraryClient.deletePaperTask(taskId);
        window.dispatchEvent(new CustomEvent('astrolib:entity-removed', { detail: { entityId: item.id } }));
        this.showBanner(`已移除文献《${item.title}》`, 2500);
        await this.fetchData(true);
      } catch (err: any) {
        this.showBanner(`移除失败: ${err?.message || err}`, 5000, true);
      }
    }

    private showBanner(text: string, autoHideMs: number = 0, isError: boolean = false) {
      if (this.bannerEl && this.bannerText) {
        this.bannerText.textContent = text;
        this.bannerEl.style.display = 'flex';
        if (isError) {
          this.bannerEl.classList.add('is-error');
        } else {
          this.bannerEl.classList.remove('is-error');
        }
        if (autoHideMs > 0) {
          setTimeout(() => this.hideBanner(), autoHideMs);
        }
      }
    }

    private hideBanner() {
      if (this.bannerEl) this.bannerEl.style.display = 'none';
    }

    private render() {
      if (!this.gridEl) return;

      let filtered = this.entities.filter((item) => {
        if (this.activeKind !== 'all' && item.kind !== this.activeKind) {
          return false;
        }
        if (this.activeShelf === 'unshelved' && item.shelfId) return false;
        if (this.activeShelf && this.activeShelf !== 'unshelved' && item.shelfId !== this.activeShelf) {
          return false;
        }
        if (this.activeSubject !== 'all') {
          if (this.activeSubject === 'paper' && item.kind !== 'paper') return false;
          if (this.activeSubject === 'physics' && item.category !== 'physics' && item.category !== 'science') return false;
          if (this.activeSubject !== 'paper' && this.activeSubject !== 'physics' && item.category !== this.activeSubject) {
            return false;
          }
        }
        if (this.searchQuery) {
          const matchTitle = item.title.toLowerCase().includes(this.searchQuery);
          const matchAuthor = (item.author || '').toLowerCase().includes(this.searchQuery);
          const matchSub = (item.subtitle || '').toLowerCase().includes(this.searchQuery);
          if (!matchTitle && !matchAuthor && !matchSub) return false;
        }
        return true;
      });

      filtered.sort((a, b) => {
        if (this.sortKey === 'recent') {
          const aT = a.lastReadAt || a.createdAt;
          const bT = b.lastReadAt || b.createdAt;
          return bT - aT;
        }
        if (this.sortKey === 'created') return b.createdAt - a.createdAt;
        if (this.sortKey === 'progress') return (b.readProgress || 0) - (a.readProgress || 0);
        if (this.sortKey === 'title') return a.title.localeCompare(b.title, 'zh-CN');
        return 0;
      });

      if (filtered.length === 0) {
        const isFirstLaunch = this.entities.length === 0;
        this.gridEl.innerHTML = `
          <div class="library-empty">
            <span class="material-symbols-outlined" style="font-size: 48px; color: var(--md-sys-color-outline);">auto_stories</span>
            <p>${isFirstLaunch ? '书库尚未导入书籍' : '暂无符合条件的研读资源'}</p>
            <span class="empty-sub">${
              isFirstLaunch
                ? '当前为精简安装壳，请从官方书库获取教材，或导入本地 .abp / .epub 书籍与 .pdf 文献'
                : '尝试切换筛选条件，或导入新的 .abp / .epub 书籍与 .pdf 学术文献'
            }</span>
            <div class="library-empty-actions">
              <md-filled-button id="btn-empty-official-catalog">获取官方书籍 (.abp)</md-filled-button>
              <md-outlined-button id="btn-empty-upload">导入本地书籍 / 文献</md-outlined-button>
            </div>
          </div>
        `;
        document.getElementById('btn-empty-official-catalog')?.addEventListener('click', () => {
          this.openOfficialCatalog();
        });
        document.getElementById('btn-empty-upload')?.addEventListener('click', () => {
          this.fileInput?.click();
        });
        return;
      }

      this.gridEl.className = this.isListView ? 'library-entities-list' : 'library-entities-grid';
      this.gridEl.innerHTML = '';

      filtered.forEach((item, idx) => {
        const card = document.createElement('div');
        card.className = `library-card ${item.kind === 'paper' ? 'library-card--paper' : ''} ${item.status === 'processing' ? 'is-processing' : ''} ${item.status === 'error' ? 'is-error' : ''} ${item.status === 'idle' ? 'is-idle' : ''}`;
        card.setAttribute('data-id', item.id);

        const isPaper = item.kind === 'paper';
        const sourceFormat = item.metadata?.sourceFormat || 'abp';
        const kindBadge = isPaper ? '文献论文' : sourceFormat === 'epub' ? 'EPUB' : 'ABP 书籍';
        const rawCover = (item.cover || '').trim();
        const hasValidCover = Boolean(!isPaper && rawCover && rawCover !== '/favicon.png');
        const coverCandidates: string[] = [];
        if (hasValidCover) {
          const thumbUrl = this.toThumbCoverUrl(rawCover);
          if (thumbUrl && thumbUrl !== '/favicon.png') coverCandidates.push(thumbUrl);
          if (rawCover !== thumbUrl) coverCandidates.push(rawCover);
          for (const localCand of getLocalCoverFallbackCandidates(item, coverCandidates)) {
            coverCandidates.push(localCand);
          }
        } else if (!isPaper) {

          coverCandidates.push(...getLocalCoverFallbackCandidates(item));
        }
        const initialCoverSrc = coverCandidates[0] || '';

        let overlayHtml = '';
        if (item.status === 'processing') {
          overlayHtml = `
            <div class="processing-overlay">
              <div class="lib-spinner"></div>
              <span class="overlay-status-text">${item.statusMessage || 'MinerU 解析中...'}</span>
            </div>
          `;
        } else if (item.status === 'error' || item.status === 'idle') {
          const isErr = item.status === 'error';
          const btnLabel = isErr ? '重新解析' : '开始解析';
          const iconName = isErr ? 'error_outline' : 'pending';
          overlayHtml = `
            <div class="processing-overlay ${isErr ? 'is-error' : 'is-idle'}">
              <span class="material-symbols-outlined overlay-status-icon">${iconName}</span>
              <span class="overlay-status-text" title="${(item.statusMessage || '').replace(/"/g, '&quot;')}">${item.statusMessage || (isErr ? '解析失败' : '待解析')}</span>
              <div class="overlay-actions-row">
                <md-filled-tonal-button class="card-reparse-btn" type="button">${btnLabel}</md-filled-tonal-button>
                <md-icon-button class="card-delete-btn" type="button" title="移除文献" aria-label="移除文献">
                  <span class="material-symbols-outlined">delete_outline</span>
                </md-icon-button>
              </div>
            </div>
          `;
        }

        const listActionHtml =
          item.status === 'error' || item.status === 'idle'
            ? `
              <div class="card-list-actions">
                <span class="list-status-label ${item.status === 'error' ? 'is-error' : ''}">${item.statusMessage || ''}</span>
                <md-filled-tonal-button class="card-reparse-btn" type="button">${item.status === 'error' ? '重新解析' : '开始解析'}</md-filled-tonal-button>
                <md-icon-button class="card-delete-btn" type="button" title="移除文献" aria-label="移除文献">
                  <span class="material-symbols-outlined">delete_outline</span>
                </md-icon-button>
              </div>
            `
            : item.status === 'processing'
              ? `<div class="card-list-actions"><span class="list-status-label">${item.statusMessage || '解析中...'}</span></div>`
              : '';

        card.innerHTML = `
          <div class="card-cover-box">
            ${
              !initialCoverSrc
                ? buildAcademicDefaultCoverHtml(item)
                : `<img src="${initialCoverSrc.replace(/"/g, '&quot;')}" class="card-cover-img" alt="${item.title.replace(/"/g, '&quot;')}" width="360" height="480" decoding="async" loading="${idx < 12 ? 'eager' : 'lazy'}" fetchpriority="${idx < 6 ? 'high' : 'auto'}" />`
            }
            <span class="card-kind-pill">${kindBadge}</span>
            ${overlayHtml}
          </div>
          <div class="card-meta">
            <h3 class="card-title" title="${item.title.replace(/"/g, '&quot;')}">${item.title}</h3>
            <p class="card-author" title="${(item.author || '').replace(/"/g, '&quot;')}">${item.author || item.publisher || 'AstroLib'}</p>
          </div>
          ${listActionHtml}
        `;

        card.querySelectorAll('.card-reparse-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            void reparseEntityTask(item, this.getPipelineCallbacks());
          });
        });
        card.querySelectorAll('.card-delete-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            void this.deletePaper(item);
          });
        });

        const imgEl = card.querySelector<HTMLImageElement>('.card-cover-img');
        if (imgEl) {
          let candidateIndex = 0;
          const tryNextFallback = () => {
            candidateIndex += 1;
            if (candidateIndex < coverCandidates.length) {
              imgEl.src = coverCandidates[candidateIndex];
              return;
            }
            const tpl = document.createElement('template');
            tpl.innerHTML = buildAcademicDefaultCoverHtml(item);
            const fallbackNode = tpl.content.firstElementChild;
            if (fallbackNode) {
              imgEl.replaceWith(fallbackNode);
            } else {
              imgEl.remove();
            }
          };
          imgEl.addEventListener('error', tryNextFallback);
          if (imgEl.complete && imgEl.naturalWidth === 0) {
            tryNextFallback();
          }
        }

        card.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.card-reparse-btn, .card-delete-btn')) {
            return;
          }
          window.dispatchEvent(
            new CustomEvent('astrolib:open-reading-entity', {
              detail: item,
            })
          );
        });

        this.gridEl!.appendChild(card);
      });
    }

    private openOfficialCatalog() {
      const modal = document.getElementById('official-catalog-modal');
      if (modal) {
        modal.style.display = 'flex';
        this.loadOfficialCatalog();
      }
    }

    private closeOfficialCatalog() {
      const modal = document.getElementById('official-catalog-modal');
      if (modal) modal.style.display = 'none';
    }

    private async loadOfficialCatalog() {
      const bodyEl = document.getElementById('official-catalog-body');
      const sourceEl = document.getElementById('official-catalog-source');
      if (!bodyEl) return;

      bodyEl.innerHTML = `
        <div class="library-loading-placeholder">
          <div class="lib-spinner"></div>
          <p>正在拉取官方发行目录...</p>
        </div>
      `;

      try {
        const [catalog, installedBooks] = await Promise.all([
          libraryClient.fetchOfficialCatalog(),
          libraryClient.getInstalledBooks(),
        ]);

        if (sourceEl && catalog?.sourceUrl) {
          sourceEl.textContent = `源清单: ${catalog.sourceUrl}${catalog.releaseTag ? ` (${catalog.releaseTag})` : ''}`;
        }

        const installedMap = new Map<string, any>();
        for (const b of installedBooks) {
          if (b?.manifest?.id) installedMap.set(b.manifest.id, b.manifest);
        }

        const books = Array.isArray(catalog?.books) ? catalog.books : [];
        if (books.length === 0) {
          bodyEl.innerHTML = `<div class="official-catalog-error">官方目录为空，请稍后重试或使用本地 .abp 导入。</div>`;
          return;
        }

        const list = document.createElement('div');
        list.className = 'official-catalog-list';

        for (const entry of books) {
          const installed = installedMap.get(entry.id);
          const hasUpdate = Boolean(installed && entry.contentHash && installed.contentHash !== entry.contentHash);
          const sizeMb = entry.sizeBytes ? `${(entry.sizeBytes / 1048576).toFixed(2)} MB` : '未知大小';

          const row = document.createElement('div');
          row.className = 'official-catalog-row';

          const info = document.createElement('div');
          info.className = 'official-catalog-info';
          info.innerHTML = `
            <div class="official-catalog-name"></div>
            <div class="official-catalog-meta"></div>
          `;
          info.querySelector('.official-catalog-name')!.textContent = entry.title || entry.id;
          info.querySelector('.official-catalog-meta')!.textContent =
            `${entry.author || 'AstroLib'} · ${entry.totalChapters || 0} 章 · ${sizeMb}`;

          const actionWrap = document.createElement('div');
          actionWrap.className = 'official-catalog-action';

          const btn: any = document.createElement(installed && !hasUpdate ? 'md-outlined-button' : 'md-filled-button');
          if (installed && !hasUpdate) {
            btn.textContent = '已安装';
            btn.disabled = true;
          } else {
            btn.textContent = hasUpdate ? '更新' : '下载安装';
            btn.addEventListener('click', async () => {
              btn.disabled = true;
              btn.textContent = '安装中...';
              this.showBanner(`正在从官方 Release 下载并校验《${entry.title}》...`);
              try {
                await libraryClient.installOfficialBook(entry);
                btn.textContent = '已安装';
                this.showBanner(`《${entry.title}》安装并校验完成！`, 3500);
                await this.fetchData();
              } catch (err: any) {
                btn.disabled = false;
                btn.textContent = hasUpdate ? '重试更新' : '重试安装';
                this.showBanner(`安装《${entry.title}》失败: ${err?.message || err}`, 8000, true);
              }
            });
          }

          actionWrap.appendChild(btn);
          row.appendChild(info);
          row.appendChild(actionWrap);
          list.appendChild(row);
        }

        bodyEl.innerHTML = '';
        bodyEl.appendChild(list);
      } catch (err: any) {
        bodyEl.innerHTML = '';
        const errBox = document.createElement('div');
        errBox.className = 'official-catalog-error';
        errBox.innerHTML = `
          <p class="official-error-title">无法获取官方发行目录</p>
          <p class="official-error-detail"></p>
          <div class="library-empty-actions">
            <md-filled-button id="btn-catalog-err-upload">导入本地 .abp 文件</md-filled-button>
            <md-outlined-button id="btn-catalog-err-retry">重试连接</md-outlined-button>
          </div>
        `;
        errBox.querySelector('.official-error-detail')!.textContent = String(err?.message || err);
        bodyEl.appendChild(errBox);
        document.getElementById('btn-catalog-err-upload')?.addEventListener('click', () => {
          this.closeOfficialCatalog();
          this.fileInput?.click();
        });
        document.getElementById('btn-catalog-err-retry')?.addEventListener('click', () => {
          this.loadOfficialCatalog();
        });
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new DesktopLibraryController());
  } else {
    new DesktopLibraryController();
  }
</script>
