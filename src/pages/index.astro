---
/**
 * src/pages/index.astro
 * ============================================================================
 * AstroLib 统一入口重定向页面
 * ============================================================================
 * 默认直接跳转至桌面工作台 (/desktop/)，同时支持参数显式路由至阅读器 (/reader/)，
 * 并在无脚本/降级场景提供到 /desktop/ 与 /reader/ 的直达通道。
 * ============================================================================
 */
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="0;url=/desktop/" />
    <link rel="canonical" href="/desktop/" />
    <title>AstroLib - 理工科学术教辅系统</title>
    <script is:inline>
      try {
        const params = new URLSearchParams(window.location.search);
        if (params.get('mode') === 'reader' || params.has('reader')) {
          window.location.replace('/reader/' + window.location.search);
        } else {
          window.location.replace('/desktop/' + window.location.search);
        }
      } catch {
        window.location.replace('/desktop/');
      }
    </script>
  </head>
  <body>
    <p style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center;">
      正在进入 AstroLib 工作台... <a href="/desktop/">工作台主页</a> · <a href="/reader/">阅读器</a>
    </p>
  </body>
</html>
