---
/**
 * src/pages/workspace/ingest.astro
 * ============================================================================
 * AstroLib 纯净单文献双栏研读视窗 (Material Design 3 & MD3 Expressive)
 * ============================================================================
 * 规范：
 * 1. 严格单文献阅读：无侧栏、无重复 Logo、无独立设置、无常驻解析按钮；
 * 2. 所有文献统一由「研读书库」打开（?taskId=...）；
 * 3. 全局设置同步驱动字体、行距、字阶、版面显示及即点即译；
 * 4. 全部交互控件采用官方 @material/web 与 @m3e/web 组件。
 * ============================================================================
 */

import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/noto-serif-sc';
import '@fontsource-variable/plus-jakarta-sans';
import '../../styles/tokens/layers.css';
import '../../themes/material-you/tokens.css';
import '../../styles/fonts.css';
import 'katex/dist/katex.min.css';
import './ingest.css';

import { collections } from '../../config/collections.config.ts';

const siteTitle = '学术文献双栏研读 · AstroLib';
---

<!DOCTYPE html>
<html lang="zh-CN" data-site-theme="material-you">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <link rel="icon" href="/favicon.png" />

    <!-- 首屏免闪烁预注入 Material You 动态主题色与亮暗模式 -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('starlight-theme');
          var resolvedT =
            t === 'dark' || t === 'light'
              ? t
              : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = resolvedT;
          document.documentElement.style.colorScheme = resolvedT;
          document.documentElement.dataset.siteTheme = 'material-you';

          var m3Color = localStorage.getItem('starlight-m3-theme-color');
          if (m3Color) document.documentElement.dataset.m3ThemeColor = m3Color;

          var cachedCss = localStorage.getItem('astrolib_m3_cached_css');
          if (cachedCss) {
            var styleEl = document.createElement('style');
            styleEl.id = 'm3-dynamic-color-theme';
            styleEl.textContent = cachedCss;
            document.head.appendChild(styleEl);

            document.addEventListener('DOMContentLoaded', function () {
              if (styleEl && document.head.lastElementChild !== styleEl) {
                document.head.appendChild(styleEl);
              }
            });
          }
        } catch (e) {}
      })();
    </script>

  </head>
  <body class="ingest-app-body">
    <div class="ingest-workspace-root">
      <!-- 纯净单文献顶栏 -->
      <header class="ingest-topbar">
        <div class="topbar-left">
          <div class="doc-name-badge">
            <span class="material-symbols-outlined doc-title-icon">description</span>
            <span class="doc-name-text" id="doc-name-text">正在加载文献...</span>
          </div>
        </div>

        <div class="topbar-center">
          <m3e-segmented-button id="view-mode-segmented" hide-selection-indicator aria-label="双栏视图模式">
            <m3e-button-segment value="structured" checked>结构化对照</m3e-button-segment>
            <m3e-button-segment value="bilingual">双语研判</m3e-button-segment>
            <m3e-button-segment value="continuous">连续阅读</m3e-button-segment>
          </m3e-segmented-button>
        </div>

        <div class="topbar-right">
          <md-icon-button id="btn-download-zip" style="display: none;" title="下载清洗包归档 (ZIP)" aria-label="下载清洗包归档 (ZIP)">
            <span class="material-symbols-outlined">download</span>
          </md-icon-button>
          <md-icon-button id="btn-export-book" style="display: none;" title="转入 AstroLib 书籍合集" aria-label="转入 AstroLib 书籍合集">
            <span class="material-symbols-outlined">auto_stories</span>
          </md-icon-button>
        </div>
      </header>

      <!-- MD3 顶部进度条 -->
      <md-linear-progress id="paper-linear-progress" class="paper-linear-progress" value="0" style="display: none;"></md-linear-progress>

      <!-- 错误提示横幅 -->
      <div class="ingest-error-banner" id="ingest-error-banner" style="display: none;" role="alert">
        <div class="ingest-error-content">
          <span class="material-symbols-outlined" style="font-size: 20px; color: var(--md-sys-color-error, #ba1a1a);">error</span>
          <span class="ingest-error-text" id="ingest-error-text">解析出错</span>
        </div>
        <md-icon-button id="btn-close-error-banner" title="关闭提示" aria-label="关闭提示">
          <span class="material-symbols-outlined">close</span>
        </md-icon-button>
      </div>

      <!-- 无指定文献时的极简空状态 -->
      <div class="paper-empty-stage" id="paper-empty-stage" style="display: none;">
        <span class="material-symbols-outlined paper-empty-icon">description</span>
        <h3 class="paper-empty-title">请从研读书库打开学术文献</h3>
        <p class="paper-empty-desc">所有 PDF 文献均由「研读书库」统一上传解析并在对应卡片打开。</p>
        <md-filled-tonal-button id="btn-empty-goto-library">返回研读书库</md-filled-tonal-button>
      </div>

      <!-- 双栏对照主体 -->
      <main class="workspace-grid" id="paper-workspace-grid">
        <!-- 左栏：PDF 原文视图 -->
        <section class="pane-pdf">
          <div class="pdf-toolbar">
            <span class="pdf-toolbar-title">原文件</span>

            <div class="pdf-page-controls">
              <md-icon-button id="pdf-page-prev" title="上一页" aria-label="上一页">
                <span class="material-symbols-outlined">chevron_left</span>
              </md-icon-button>
              <input type="text" class="pdf-page-current-input" id="pdf-page-input" value="1" title="输入页码回车跳转" />
              <span class="pdf-page-total-text" id="pdf-page-total">/ 1</span>
              <md-icon-button id="pdf-page-next" title="下一页" aria-label="下一页">
                <span class="material-symbols-outlined">chevron_right</span>
              </md-icon-button>
            </div>

            <div class="pdf-zoom-controls">
              <md-icon-button id="pdf-zoom-out" title="缩小" aria-label="缩小">
                <span class="material-symbols-outlined">remove</span>
              </md-icon-button>
              <span class="pdf-zoom-val" id="pdf-zoom-val">100%</span>
              <md-icon-button id="pdf-zoom-in" title="放大" aria-label="放大">
                <span class="material-symbols-outlined">add</span>
              </md-icon-button>
              <md-text-button id="pdf-zoom-fit" title="适应页面宽度">适应宽度</md-text-button>
            </div>
          </div>

          <div class="pdf-canvas-scroll-area" id="pdf-canvas-scroll-area"></div>
        </section>

        <!-- 右栏：结构化内容与阅读视窗 -->
        <section class="pane-markdown" id="pane-markdown">
          <div class="content-toolbar">
            <m3e-segmented-button id="content-tab-segmented" hide-selection-indicator class="content-tab-segmented" aria-label="解析视图格式">
              <m3e-button-segment value="markdown" checked>Markdown</m3e-button-segment>
              <m3e-button-segment value="json">JSON</m3e-button-segment>
            </m3e-segmented-button>

            <div class="content-toolbar-right">
              <div class="bilingual-batch-controls" id="bilingual-batch-controls" style="display: none;">
                <md-filled-tonal-button id="btn-batch-translate-current" title="批量研判当前可视页">研判当前页</md-filled-tonal-button>
                <md-outlined-button id="btn-batch-translate-all" title="全篇自动批量研判">全篇研判</md-outlined-button>
              </div>
              <md-icon-button id="btn-copy-content" title="复制全文内容" aria-label="复制全文内容">
                <span class="material-symbols-outlined">content_copy</span>
              </md-icon-button>
            </div>
          </div>

          <div class="content-scroll-area" id="content-scroll-area">
            <div class="structured-blocks-container" id="structured-blocks-container"></div>
            <article class="continuous-reading-flow" id="continuous-reading-container" style="display: none;"></article>
            <pre class="pane-json-container" id="json-view-container" style="display: none;"></pre>
          </div>
        </section>
      </main>
    </div>

    <!-- 转入 AstroLib 书籍合集弹窗 (标准 MD3 Dialog) -->
    <md-dialog id="export-modal">
      <div slot="headline">转入 AstroLib 书籍合集</div>
      <div slot="content" class="export-dialog-body">
        <p class="export-dialog-desc">将解析成果规整为规范 MDX 章节并注入全书目录与阅读器。</p>
        <div class="export-field-group">
          <span class="export-field-label">所属学科合集</span>
          <md-chip-set id="export-collection-chips">
            {collections.map((c, idx) => (
              <md-filter-chip label={`${c.title} (${c.slug})`} data-col-slug={c.slug} selected={idx === 0 ? true : undefined}></md-filter-chip>
            ))}
          </md-chip-set>
        </div>
        <md-outlined-text-field id="export-slug-input" label="书籍 / 论文 Slug" placeholder="例如 my-paper-2026"></md-outlined-text-field>
        <md-outlined-text-field id="export-title-input" label="显示书名 / 文献标题" placeholder="输入完整标题"></md-outlined-text-field>
      </div>
      <div slot="actions">
        <md-text-button id="btn-close-export">取消</md-text-button>
        <md-filled-button id="btn-confirm-export">确认入库</md-filled-button>
      </div>
    </md-dialog>

    <!-- 单例脚注悬停微浮窗 -->
    <div class="doc-footnote-popover" id="doc-footnote-popover"></div>

    <!-- 单例 M3 单词即点即译浮动卡片 -->
    <div class="m3-word-popover" id="m3-word-popover" role="dialog" aria-hidden="true" style="display: none;"></div>

    <!-- 客户端核心控制器与标准组件注册 -->
    <script>
      import '@material/web/button/filled-button.js';
      import '@material/web/button/filled-tonal-button.js';
      import '@material/web/button/outlined-button.js';
      import '@material/web/button/text-button.js';
      import '@material/web/iconbutton/icon-button.js';
      import '@material/web/progress/linear-progress.js';
      import '@material/web/dialog/dialog.js';
      import '@material/web/textfield/outlined-text-field.js';
      import '@material/web/chips/chip-set.js';
      import '@material/web/chips/filter-chip.js';
      import '@m3e/web/segmented-button';
      import { initPaperReader } from '../../features/doc-ingestion/paper-reader-controller';
      import { initColorEngine, applyThemeColor } from '../../themes/material-you/color-engine';

      initColorEngine();

      window.addEventListener('storage', (e) => {
        if (e.key === 'starlight-m3-theme-color') {
          applyThemeColor(e.newValue || undefined);
        } else if (e.key === 'astrolib_m3_cached_css' && e.newValue) {
          let styleEl = document.getElementById('m3-dynamic-color-theme') as HTMLStyleElement | null;
          if (!styleEl) {
            styleEl = document.createElement('style');
            styleEl.id = 'm3-dynamic-color-theme';
          }
          styleEl.textContent = e.newValue;
          document.head.appendChild(styleEl);
        } else if (e.key === 'starlight-theme') {
          const themeVal = e.newValue;
          const effective =
            themeVal === 'dark' || themeVal === 'light'
              ? themeVal
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = effective;
          document.documentElement.style.colorScheme = effective;
        }
      });

      window.addEventListener('message', (e) => {
        if (e.data && e.data.type === 'M3_THEME_COLOR_CHANGED') {
          if (e.data.theme || e.data.resolvedTheme) {
            const effective =
              e.data.resolvedTheme === 'dark' || e.data.resolvedTheme === 'light'
                ? e.data.resolvedTheme
                : e.data.theme === 'dark' || e.data.theme === 'light'
                  ? e.data.theme
                  : window.matchMedia('(prefers-color-scheme: dark)').matches
                    ? 'dark'
                    : 'light';
            document.documentElement.dataset.theme = effective;
            document.documentElement.style.colorScheme = effective;
          }
          const cssContent = e.data.schemeCss || e.data.css;
          if (cssContent) {
            let styleEl = document.getElementById('m3-dynamic-color-theme') as HTMLStyleElement | null;
            if (!styleEl) {
              styleEl = document.createElement('style');
              styleEl.id = 'm3-dynamic-color-theme';
            }
            styleEl.textContent = cssContent;
            document.head.appendChild(styleEl);
          } else if (e.data.color) {
            applyThemeColor(e.data.color);
          }
        }
      });

      initPaperReader();
    </script>
  </body>
</html>
