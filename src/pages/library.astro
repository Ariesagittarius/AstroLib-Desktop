---
import { features } from '../config/features.config.mjs';
import { cleanSlug } from '../utils/slug.mjs';
import M3TopNavBar from '../components/m3/M3TopNavBar.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/pages/library.css';
import fs from 'node:fs';
import path from 'node:path';

function getEpubUrl(slug: string) {
  if (!features.epub?.enabled) return null;
  try {
    if (fs.existsSync(`public/epub/${slug}.epub`)) {
      return `/epub/${slug}.epub`;
    }
  } catch {}
  if (features.epub?.config?.releaseBaseUrl) {
    return `${features.epub.config.releaseBaseUrl}/${slug}.epub`;
  }
  return null;
}

const siteUrl = (features.seo?.config?.siteUrl || 'https://astrolib.cloud').replace(/\/$/, '');
const pageTitle = '云端书库与扩展中心 · AstroLib';
const pageDescription = '浏览 AstroLib 云端书库所有可安装的理工科教材、教辅与学术资料，支持一键安装至本地书架即装即读。';

const librarySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: `${siteUrl}/library/`,
  inLanguage: 'zh-CN',
  isPartOf: {
    '@type': 'WebSite',
    name: 'AstroLib',
    url: `${siteUrl}/`,
  },
};

let catalogBooks: any[] = [];
try {
  const catPath = path.resolve('content-sources/catalog-registry.json');
  const pubPath = path.resolve('public/abp-packs/catalog.json');
  const targetPath = fs.existsSync(catPath) ? catPath : pubPath;
  if (fs.existsSync(targetPath)) {
    const raw = fs.readFileSync(targetPath, 'utf8');
    const parsed = JSON.parse(raw);
    catalogBooks = (parsed.books || []).map((b: any) => {
      const isSenior = b.slug.includes('senior') || b.category === 'supplement';
      const stage = isSenior ? 'high-school' : 'university';
      const stageLabel = isSenior ? '高中' : '大学本科';
      const categoryLabel = b.category === 'supplement' ? '教辅' : '教材';
      const cleanEp = cleanSlug(b.entryPoint || '');
      const epubUrl = getEpubUrl(b.slug);
      return {
        id: b.id,
        slug: b.slug,
        colSlug: b.colSlug,
        title: b.title,
        author: b.author || 'AstroLib',
        publisher: b.publisher || '高等教育出版社',
        edition: b.edition || '标准数字化版',
        isbn: b.isbn || '',
        stage,
        stageLabel,
        category: b.category || 'textbook',
        categoryLabel,
        subject: b.subject || b.colSlug || 'math',
        description: b.description || '',
        cover: b.cover || '/favicon.png',
        entryPoint: cleanEp,
        packFileName: b.packFileName || `${b.colSlug}-${b.slug}.abp`,
        sizeBytes: b.sizeBytes || 0,
        readUrl: `/collections/${b.colSlug}/${b.slug}/${cleanEp}/`,
        hasEpubFile: !!epubUrl,
        epubUrl: epubUrl || `/epub/${b.slug}.epub`,
      };
    });
  }
} catch (e) {
  console.error('[library.astro] 加载 catalog.json 失败:', e);
}

const allBooks = catalogBooks;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="AstroLib, 书目检索, 数学教材, 物理教材, 大学教材, 高中数学, 教辅, 习题册" />
    <link rel="canonical" href={`${siteUrl}/library/`} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`${siteUrl}/library/`} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/astrolib-logo.png`} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/astrolib-logo.png`} />

    <!-- Schema.org 结构化数据 (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(librarySchema)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <!-- M3 Top App Bar -->
    <M3TopNavBar currentPath="/library/" />

    <main class="lib-container">
      <!-- Breadcrumb -->
      <nav class="lib-breadcrumb" aria-label="面包屑导航">
        <a href="/">首页</a>
        <span>/</span>
        <span>书目索引与检索</span>
      </nav>

      <!-- Header -->
      <div class="lib-header">
        <h1 class="lib-title">书目检索与分类索引</h1>
        <p class="lib-subtitle">
          支持按学段、资料分类与学科领域检索 AstroLib 所收录的数理教材、教辅与课后习题。
        </p>
      </div>

      <!-- Filter Panel -->
      <section class="filter-panel" aria-label="多维分类检索栏">
        <!-- 1. Search Row -->
        <div class="filter-search-row">
          <svg class="search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="8.5" cy="8.5" r="5.5" />
            <path d="M12.5 12.5L17 17" stroke-linecap="round" />
          </svg>
          <input
            type="text"
            id="lib-search-input"
            class="search-main-input"
            placeholder="检索书名、作者、ISBN、出版社或关键词..."
            autocomplete="off"
          />
          <button type="button" id="lib-search-clear" class="search-clear-btn" aria-label="清空检索词">✕</button>
        </div>

        <!-- 2. Stage Filter -->
        <div class="filter-dim-row">
          <span class="dim-label">学段</span>
          <div class="dim-pills">
            <button type="button" class="dim-btn active" data-filter-type="stage" data-filter-val="all">全部</button>
            <button type="button" class="dim-btn" data-filter-type="stage" data-filter-val="high-school">高中 (1)</button>
            <button type="button" class="dim-btn" data-filter-type="stage" data-filter-val="university">大学本科 (5)</button>
            <button type="button" class="dim-btn disabled" data-filter-type="stage" data-filter-val="middle-school">初中 (预备)</button>
            <button type="button" class="dim-btn disabled" data-filter-type="stage" data-filter-val="postgraduate">考研 (预备)</button>
          </div>
        </div>

        <!-- 3. Category Filter -->
        <div class="filter-dim-row">
          <span class="dim-label">类别</span>
          <div class="dim-pills">
            <button type="button" class="dim-btn active" data-filter-type="category" data-filter-val="all">全部</button>
            <button type="button" class="dim-btn" data-filter-type="category" data-filter-val="supplement">教辅</button>
            <button type="button" class="dim-btn" data-filter-type="category" data-filter-val="textbook">教材</button>
            <button type="button" class="dim-btn" data-filter-type="category" data-filter-val="exercise">课后习题</button>
          </div>
        </div>

        <!-- 4. Subject Filter -->
        <div class="filter-dim-row">
          <span class="dim-label">学科</span>
          <div class="dim-pills">
            <button type="button" class="dim-btn active" data-filter-type="subject" data-filter-val="all">全部</button>
            <button type="button" class="dim-btn" data-filter-type="subject" data-filter-val="math">数学</button>
            <button type="button" class="dim-btn" data-filter-type="subject" data-filter-val="science">物理</button>
            <button type="button" class="dim-btn disabled" data-filter-type="subject" data-filter-val="chemistry">化学 (预备)</button>
          </div>
        </div>
      </section>

      <!-- Results Indicator & Sort -->
      <div class="results-controls-row">
        <div class="active-filters-wrap" id="active-filters-container">
          <span class="results-summary">收录书目：<strong id="matched-count">{allBooks.length}</strong> 部</span>
        </div>

        <div class="sort-view-controls">
          <label for="sort-select">排序：</label>
          <select id="sort-select" class="sort-select">
            <option value="default">默认</option>
            <option value="title-asc">书名 (A-Z)</option>
            <option value="stage-asc">学段 (由低到高)</option>
            <option value="stage-desc">学段 (由高到低)</option>
          </select>
        </div>
      </div>

      <!-- Book List -->
      <div id="books-list" class="books-display-list">
        {allBooks.map(book => (
          <article
            class="lib-book-row"
            data-id={book.id}
            data-title={book.title}
            data-author={book.author || ''}
            data-publisher={book.publisher || ''}
            data-isbn={book.isbn || ''}
            data-stage={book.stage}
            data-category={book.category}
            data-subject={book.subject}
            data-tags={(book.tags || []).join(',')}
            data-desc={book.description}
            data-entry={book.readUrl}
            data-epub={book.epubUrl}
            data-has-epub={book.hasEpubFile ? '1' : '0'}
            data-edition={book.edition || ''}
          >
            <div class="book-thumb" style={`background-image: url(${book.cover});`}></div>
            <div class="book-details-wrap">
              <div class="book-row-header">
                <h2 class="book-title">
                  <span class="book-title-text">{book.title}</span>
                </h2>
                <span class="stage-badge">{book.stageLabel}</span>
                <span class="stage-badge">{book.categoryLabel}</span>
              </div>

              <div class="book-meta-line">
                <span>著者：{book.author}</span>
                <span>出版：{book.publisher}</span>
                {book.isbn && <span>ISBN：{book.isbn}</span>}
                {book.edition && <span>版次：{book.edition}</span>}
              </div>

              <p class="book-desc-text">{book.description}</p>

              <div class="book-row-actions" data-book-id={book.id} data-col={book.colSlug} data-slug={book.slug} data-pack={book.packFileName} data-entry={book.readUrl}>
                <button type="button" class="btn-read-action btn-install-action" data-action="install">
                  📥 安装到书架
                </button>
                <a href={book.readUrl} class="btn-read-action btn-enter-action" style="display: none;">
                  进入阅读 →
                </a>
                <button type="button" class="btn-sub-action btn-uninstall-action" data-action="uninstall" style="display: none;">
                  卸载
                </button>
                <button type="button" class="btn-sub-action btn-modal-trigger">
                  详细信息
                </button>
                {book.hasEpubFile && (
                  <a href={book.epubUrl} class="btn-sub-action" download>
                    EPUB 下载
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State -->
      <div id="lib-empty-box" class="empty-box">
        <p class="empty-text">未检索到匹配的书目。</p>
        <button type="button" id="lib-empty-reset" class="btn-sub-action">清空筛选条件</button>
      </div>
    </main>

    <!-- Details Modal -->
    <div id="details-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="dialog-title">
      <div class="modal-card">
        <button type="button" id="dialog-close-btn" class="modal-close" aria-label="关闭详情">✕</button>
        <div class="modal-head">
          <h2 id="dialog-title" class="modal-title"></h2>
          <div id="dialog-author" class="modal-author"></div>
        </div>

        <div class="modal-body-content">
          <p id="dialog-desc" style="font-size: 0.875rem; line-height: 1.65; color: var(--vp-text-2); margin-bottom: 1rem;"></p>
          <table class="modal-table">
            <tbody>
              <tr>
                <td>出版社</td>
                <td id="dialog-publisher"></td>
              </tr>
              <tr>
                <td>标准书号</td>
                <td id="dialog-isbn" style="font-family: monospace;"></td>
              </tr>
              <tr>
                <td>版次</td>
                <td id="dialog-edition"></td>
              </tr>
              <tr>
                <td>适用学段</td>
                <td id="dialog-stage"></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="modal-actions">
          <a id="dialog-read-btn" href="#" class="btn-read-action">进入阅读</a>
          <a id="dialog-epub-btn" href="#" class="btn-sub-action" download style="display: none;">下载 EPUB</a>
        </div>
      </div>
    </div>

    <!-- Script -->
    <script>
      import { initLibraryClient } from '../scripts/pages/library-client';
      initLibraryClient();
    </script>
    <Analytics />
  </body>
</html>
